  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_cp_ruptura_democratica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 359-L. Tentar, com emprego de violencia ou grave ameaca, abolir o Estado Democratico de Direito, impedindo ou restringindo o exercicio dos poderes constitucionais. Art. 359-M. Tentar depor, por meio de violencia ou grave ameaca, o governo legitimamente constituido.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_cp_ruptura_democratica</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/codigo_penal_1940" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 359-L. Tentar, com emprego de violencia ou grave ameaca, abolir o Estado Democratico de Direito, impedindo ou restringindo o exercicio dos poderes constitucionais. Art. 359-M. Tentar depor, por meio de violencia ou grave ameaca, o governo legitimamente constituido.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codigo_penal_1940</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/extremismo_antidemocratico" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/codigo_penal_1940" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_cp_ruptura_democratica</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Os tipos penais ancoram a categoria operacional quando o conteudo defende explicitamente ruptura do exercicio dos Poderes ou deposicao violenta de governo legitimamente constituido, sem converter toda classificacao em enquadramento penal automatico.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arts. 359-L e 359-M</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_lei_14192_violencia_politica_mulher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 326-B. Assediar, constranger, humilhar, perseguir ou ameacar candidata a cargo eletivo ou detentora de mandato eletivo com menosprezo ou discriminacao a condicao de mulher ou a sua cor, raca ou etnia, para impedir ou dificultar campanha ou mandato.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_lei_14192_violencia_politica_mulher</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lei_14192_2021" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 326-B. Assediar, constranger, humilhar, perseguir ou ameacar candidata a cargo eletivo ou detentora de mandato eletivo com menosprezo ou discriminacao a condicao de mulher ou a sua cor, raca ou etnia, para impedir ou dificultar campanha ou mandato.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lei_14192_2021</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/injuria_eleitoral" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/odio_direcionado_a_grupos" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lei_14192_2021" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_lei_14192_violencia_politica_mulher</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O tipo fornece ancora juridica para violencia politica contra a mulher e reforca que a misoginia pode ser reconhecida analiticamente sem ser reduzida a um tipo penal autonomo.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 4, art. 326-B do Codigo Eleitoral</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_lei_14532_injuria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">A Lei 14.532 de 2023 incluiu o art. 2-A na Lei 7.716 de 1989 e atualizou o art. 140, paragrafo 3, do Codigo Penal.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_lei_14532_injuria</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lei_14532_2023" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Lei 14.532 de 2023 incluiu o art. 2-A na Lei 7.716 de 1989 e atualizou o art. 140, paragrafo 3, do Codigo Penal.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lei_14532_2023</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/injuria_eleitoral" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lei_14532_2023" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_lei_14532_injuria</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lei separa a injuria racial no art. 2-A da Lei 7.716 de 1989 e mantem no Codigo Penal a injuria com elementos de religiao, idade ou deficiencia.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arts. 1 e 2</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
