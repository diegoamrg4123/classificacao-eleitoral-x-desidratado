    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_lei_7716_injuria_racial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 2-A. Injuriar alguem, ofendendo-lhe a dignidade ou o decoro, em razao de raca, cor, etnia ou procedencia nacional.</dcterms:description>
