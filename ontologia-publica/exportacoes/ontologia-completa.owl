    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As evidencias preponderantes correspondem a outro grau do mesmo espectro.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As evidencias disponiveis correspondem ao grau descrito.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Artefato com fortes indicadores de sintese ou manipulacao, mas sem confirmacao tecnica conclusiva.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_midiatica" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provavelmente Sintético ou Manipulado</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/recortado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Imagem, video ou audio cortado para remover elementos ou trechos cujo contexto alteraria a interpretacao.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Recortado</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado" />
    <skos:definition xml:lang="pt-BR">Imagem, video ou audio cortado para remover elementos ou trechos cujo contexto alteraria a interpretacao.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recortado</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Recortado</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recorte apenas espacial ou temporal sem perda de contexto necessario.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O recorte exclui informacao relevante e produz leitura materialmente diferente do original.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imagem, video ou audio cortado para remover elementos ou trechos cujo contexto alteraria a interpretacao.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recortado</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/sugestivamente_ilicito">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo com fortes indicios de ilicitude e elementos tipicos presentes, sem confirmacao definitiva.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Sugestivamente Ilícito</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <skos:definition xml:lang="pt-BR">Conteudo com fortes indicios de ilicitude e elementos tipicos presentes, sem confirmacao definitiva.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sugestivamente_ilicito</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Sugestivamente Ilícito</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Confirmacao conclusiva, equilibrio de interpretacoes ou predominio de licitude.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elementos tipicos e contexto sustentam probabilidade alta de ilicitude.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo com fortes indicios de ilicitude e elementos tipicos presentes, sem confirmacao definitiva.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sugestivamente Ilícito</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/sugestivamente_inveridico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Preponderancia de evidencia contradiz a afirmacao, embora reste margem limitada de duvida.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Sugestivamente Inverídico</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Preponderancia de evidencia contradiz a afirmacao, embora reste margem limitada de duvida.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sugestivamente_inveridico</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Sugestivamente Inverídico</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Falsidade incontroversa, ausencia de preponderancia ou predominio de evidencia favoravel.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A maioria das fontes confiaveis contradiz a afirmacao sem falsidade conclusiva.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preponderancia de evidencia contradiz a afirmacao, embora reste margem limitada de duvida.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sugestivamente Inverídico</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/sugestivamente_licito">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo provavelmente licito, embora contenha elementos que ainda geram duvida interpretativa.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Sugestivamente Lícito</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <skos:definition xml:lang="pt-BR">Conteudo provavelmente licito, embora contenha elementos que ainda geram duvida interpretativa.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sugestivamente_licito</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Sugestivamente Lícito</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Licitude incontroversa ou indicios relevantes de ilicitude.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Predominam liberdade de expressao e ausencia de elemento tipico, com pequena margem de duvida.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo provavelmente licito, embora contenha elementos que ainda geram duvida interpretativa.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sugestivamente Lícito</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/sugestivamente_veridico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Preponderancia de evidencia apoia a afirmacao, mas permanece margem legitima para revisao.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Sugestivamente Verídico</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Preponderancia de evidencia apoia a afirmacao, mas permanece margem legitima para revisao.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sugestivamente_veridico</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Sugestivamente Verídico</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Consenso incontroverso, evidencia equilibrada ou preponderancia contraria.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A maioria das fontes confiaveis apoia a afirmacao sem consenso absoluto.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preponderancia de evidencia apoia a afirmacao, mas permanece margem legitima para revisao.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sugestivamente Verídico</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/transformado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo autentico com mudanca substancial de velocidade, tom, cor, elementos visuais ou outros atributos para enganar.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Transformado</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado" />
    <skos:definition xml:lang="pt-BR">Conteudo autentico com mudanca substancial de velocidade, tom, cor, elementos visuais ou outros atributos para enganar.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transformado</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Transformado</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Correcao tecnica, acessibilidade ou efeito artistico claramente informado.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A transformacao tecnica modifica caracteristica central e induz conclusao falsa sobre o original.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo autentico com mudanca substancial de velocidade, tom, cor, elementos visuais ou outros atributos para enganar.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformado</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Dimensao transversal que descreve o estado factual das afirmacoes verificaveis, independentemente da intencao de quem as produziu.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Veracidade da Informação</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao" />
    <skos:definition xml:lang="pt-BR">Dimensao transversal que descreve o estado factual das afirmacoes verificaveis, independentemente da intencao de quem as produziu.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">veracidade_da_informacao</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Veracidade da Informação</skos:prefLabel>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dimensao transversal que descreve o estado factual das afirmacoes verificaveis, independentemente da intencao de quem as produziu.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Contexto estrutural: use para explicar a posição hierárquica, mas não o retorne como categoria operacional.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural_context</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dimensao</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/dimensao" />
    <syn:perguntaOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As afirmacoes factuais centrais sao verdadeiras diante das evidencias disponiveis?</syn:perguntaOperacional>
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Veracidade da Informação</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/estrutural" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/video_sintetico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Video ou deepfake gerado por IA que representa fala, identidade ou situacao sem registro audiovisual autentico correspondente.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Vídeo Sintético</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <skos:altLabel xml:lang="pt-BR">deepfake de video</skos:altLabel>
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <skos:definition xml:lang="pt-BR">Video ou deepfake gerado por IA que representa fala, identidade ou situacao sem registro audiovisual autentico correspondente.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">video_sintetico</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Vídeo Sintético</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Video real apenas recortado, acelerado ou editado sem sintese gerativa central.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sequencia audiovisual foi sintetizada integralmente ou substitui identidade e fala de forma gerativa.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Video ou deepfake gerado por IA que representa fala, identidade ou situacao sem registro audiovisual autentico correspondente.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vídeo Sintético</syn:rotuloPreferido>
    <syn:sinonimos rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deepfake de video</syn:sinonimos>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
