  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_res23610_fidedignidade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">A utilizacao de conteudo na propaganda eleitoral pressupoe verificacao de elementos que permitam concluir, com razoavel seguranca, pela fidedignidade da informacao.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_res23610_fidedignidade</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23610_2019" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A utilizacao de conteudo na propaganda eleitoral pressupoe verificacao de elementos que permitam concluir, com razoavel seguranca, pela fidedignidade da informacao.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23610_2019</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/acusacao_de_fraude_institucional" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23610_2019" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_res23610_fidedignidade</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O dever de fidedignidade ancora a avaliacao de alegacoes factuais de fraude institucional quando circulam como propaganda eleitoral, sem converter duvida reconhecida ou investigacao documentada em categoria positiva.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_res23610_integridade_eleitoral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">A resolucao veda, na propaganda eleitoral, conteudo fabricado ou manipulado para difundir fatos notoriamente inveridicos ou descontextualizados com potencial de causar danos ao equilibrio do pleito ou a integridade do processo eleitoral.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_res23610_integridade_eleitoral</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23610_2019" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resolucao veda, na propaganda eleitoral, conteudo fabricado ou manipulado para difundir fatos notoriamente inveridicos ou descontextualizados com potencial de causar danos ao equilibrio do pleito ou a integridade do processo eleitoral.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23610_2019</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/acusacao_de_fraude_institucional" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23610_2019" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_res23610_integridade_eleitoral</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A regra vincula alegacoes falsas ou gravemente descontextualizadas sobre instituicoes, urnas, votacao, apuracao ou totalizacao ao bem juridico da integridade do processo eleitoral, dentro do alcance da propaganda eleitoral.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9-C</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_res23673_auditoria_urnas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">A Resolucao TSE 23.673 de 2021 dispoe sobre procedimentos de fiscalizacao e auditoria do sistema eletronico de votacao.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_res23673_auditoria_urnas</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23673_2021" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Resolucao TSE 23.673 de 2021 dispoe sobre procedimentos de fiscalizacao e auditoria do sistema eletronico de votacao.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23673_2021</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23673_2021" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_res23673_auditoria_urnas</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resolucao demonstra que o sistema possui procedimentos institucionais de fiscalizacao e auditoria. Ela sustenta a distincao entre critica tecnica documentada e alegacao conclusiva de fraude que desconsidera ou distorce mecanismos relevantes de verificacao.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ementa e procedimentos de fiscalizacao e auditoria</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/datas_eleitorais_2026">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">O Calendario Eleitoral das Eleições 2026 fixa o primeiro turno em 4 de outubro e o segundo turno em 25 de outubro. A propaganda eleitoral inicia-se em 16 de agosto de 2026.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">datas_eleitorais_2026</dcterms:identifier>
