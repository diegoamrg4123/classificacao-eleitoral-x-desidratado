    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O tipo geral ancora a categoria operacional de ofensa direta a dignidade ou ao decoro sem imputacao factual especifica.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 140, caput, paragrafos 2 e 3</syn:localizacaoNaFonte>
