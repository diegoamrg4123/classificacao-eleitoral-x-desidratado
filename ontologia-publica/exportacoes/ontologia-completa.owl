    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lei_7716_1989</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/odio_direcionado_a_grupos" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lei_7716_1989" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_lei_7716_grupos</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O artigo ancora juridicamente parte dos ataques dirigidos a grupos, sem reduzir a categoria ontologica aos grupos expressamente previstos na lei.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 20</syn:localizacaoNaFonte>
