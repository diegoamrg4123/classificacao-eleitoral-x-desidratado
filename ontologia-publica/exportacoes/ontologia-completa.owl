    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O Calendario Eleitoral das Eleições 2026 fixa o primeiro turno em 4 de outubro e o segundo turno em 25 de outubro. A propaganda eleitoral inicia-se em 16 de agosto de 2026.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
