  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#profile/classification_assistance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#GraphRagProfile" />
    <syn:graph_rag_evidence_policy xml:lang="pt-BR">Cite ITEM e SOURCE; ITEMs pendentes não são precedentes aprovados; fontes jurídicas ancoram a interpretação, mas não determinam crime, ilicitude, sanção ou veracidade.</syn:graph_rag_evidence_policy>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_profile_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">classification_assistance</syn:graph_rag_profile_id>
    <syn:graph_rag_project_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rascunho_em_revisao</syn:graph_rag_project_status>
    <syn:graph_rag_purpose xml:lang="pt-BR">Contexto recuperável para classificação assistida e revisão humana.</syn:graph_rag_purpose>
    <syn:graph_rag_selection_policy xml:lang="pt-BR">Priorize conceitos com tipo_conceito classificatorio como candidatos; use conceitos estruturais como contexto hierárquico, não como rótulos operacionais.</syn:graph_rag_selection_policy>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#project/ontologia_dominio_eleitoral_publica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#SynesisProject" />
    <dcterms:description xml:lang="pt-BR">Recorte publico para consulta por revisores. Preserva a estrutura conceitual e a relacao complementar da ontologia de origem; inclui somente proveniencia normativa e evidencias conceituais selecionadas. Nao replica o corpus, os exemplos internos ou a base experimental. Os estados de revisao permanecem inalterados.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia_dominio_eleitoral_publica</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">pt-BR</dcterms:language>
    <syn:exportsOntology rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <syn:projectStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rascunho_em_revisao</syn:projectStatus>
    <syn:usesTemplate rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#template/ontologia_dominio_eleitoral" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#relation/rel_calunia_requer_veracidade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyRelation" />
    <syn:isEvidencedBy rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_ce_calunia" />
    <syn:isEvidencedBy rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_cp_calunia" />
    <syn:justification xml:lang="pt-BR">A aplicacao de calunia eleitoral requer avaliar a falsidade da imputacao de crime sem deduzir valor especifico da escala de veracidade</syn:justification>
    <syn:notes xml:lang="pt-BR">Nao torna calunia subclasse de desinformacao nem conclui crime automaticamente</syn:notes>
    <syn:relationId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rel_calunia_requer_veracidade</syn:relationId>
    <syn:relationOrigin rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/calunia_eleitoral" />
    <syn:relationProperty rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#requerAvaliacaoDeVeracidade" />
    <syn:relationTarget rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <syn:relationTypeCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">requer_avaliacao_de_veracidade</syn:relationTypeCode>
    <syn:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aprovado</syn:reviewStatus>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#requerAvaliacaoDeVeracidade">
    <rdfs:comment xml:lang="pt-BR">A aplicacao do conceito de origem requer avaliar a dimensao de destino sem concluir valor especifico da escala</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:label xml:lang="pt-BR">Requer avaliacao de veracidade</rdfs:label>
    <rdfs:range rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <syn:conditionsOfNonUse xml:lang="pt-BR">Nao use para causalidade ou para deduzir valor da escala</syn:conditionsOfNonUse>
    <syn:conditionsOfUse xml:lang="pt-BR">Use quando a categoria depende de verificacao factual</syn:conditionsOfUse>
    <syn:direction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">origem_para_destino</syn:direction>
    <syn:relationTypeCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">requer_avaliacao_de_veracidade</syn:relationTypeCode>
    <syn:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aprovado</syn:reviewStatus>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#restricaoCompartilhamento">
