  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_constitucional_democracia_e_soberania">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 1. A Republica Federativa do Brasil constitui-se em Estado Democratico de Direito. Paragrafo unico. Todo o poder emana do povo, que o exerce por meio de representantes eleitos ou diretamente, nos termos desta Constituicao.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_constitucional_democracia_e_soberania</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/constituicao_federal_1988" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 1. A Republica Federativa do Brasil constitui-se em Estado Democratico de Direito. Paragrafo unico. Todo o poder emana do povo, que o exerce por meio de representantes eleitos ou diretamente, nos termos desta Constituicao.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constituicao_federal_1988</syn:graph_rag_citation_source_id>
