  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_lei_7716_grupos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 20. Praticar, induzir ou incitar a discriminacao ou preconceito de raca, cor, etnia, religiao ou procedencia nacional.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_lei_7716_grupos</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lei_7716_1989" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 20. Praticar, induzir ou incitar a discriminacao ou preconceito de raca, cor, etnia, religiao ou procedencia nacional.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal" />
