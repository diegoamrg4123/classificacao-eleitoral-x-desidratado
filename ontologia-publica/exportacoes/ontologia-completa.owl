  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/acusacao_de_fraude_institucional">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo que alega, sem evidencia concreta verificavel, fraude ou manipulacao sistematica por instituicoes responsaveis pelo processo eleitoral.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Acusação de Fraude Institucional</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <skos:definition xml:lang="pt-BR">Conteudo que alega, sem evidencia concreta verificavel, fraude ou manipulacao sistematica por instituicoes responsaveis pelo processo eleitoral.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acusacao_de_fraude_institucional</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Acusação de Fraude Institucional</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Denuncia com evidencia substancial, investigacao aberta por instituicao competente ou pergunta que reconhece incerteza.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha acusacao de fraude institucional sem evidencia crivel, baseada em fonte nao verificavel ou alegacao ja refutada.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo que alega, sem evidencia concreta verificavel, fraude ou manipulacao sistematica por instituicoes responsaveis pelo processo eleitoral.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acusação de Fraude Institucional</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo que dissemina alegacoes tecnicas infundadas sobre inseguranca, fraude ou manipulacao das urnas eletronicas e ignora mecanismos de auditoria.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Ataque às Urnas Eletrônicas</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <skos:definition xml:lang="pt-BR">Conteudo que dissemina alegacoes tecnicas infundadas sobre inseguranca, fraude ou manipulacao das urnas eletronicas e ignora mecanismos de auditoria.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ataque_as_urnas_eletronicas</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Ataque às Urnas Eletrônicas</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analise tecnica documentada, proposta de melhoria, pergunta aberta ou educacao sobre auditoria.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha afirmacao conclusiva de vulnerabilidade ou fraude das urnas sem respaldo tecnico verificavel.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo que dissemina alegacoes tecnicas infundadas sobre inseguranca, fraude ou manipulacao das urnas eletronicas e ignora mecanismos de auditoria.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ataque às Urnas Eletrônicas</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/audio_sintetico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Voz, fala, som ou musica criada por sintese computacional sem captacao autentica correspondente.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Áudio Sintético</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <skos:altLabel xml:lang="pt-BR">clonagem de voz</skos:altLabel>
    <skos:altLabel xml:lang="pt-BR">voz sintetica</skos:altLabel>
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <skos:definition xml:lang="pt-BR">Voz, fala, som ou musica criada por sintese computacional sem captacao autentica correspondente.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">audio_sintetico</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Áudio Sintético</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Audio real com corte, equalizacao ou mudanca simples de velocidade.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha clonagem vocal, text to speech ou sintese de som apresentada como captacao real.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voz, fala, som ou musica criada por sintese computacional sem captacao autentica correspondente.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Áudio Sintético</syn:rotuloPreferido>
    <syn:sinonimos rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clonagem de voz, voz sintetica</syn:sinonimos>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/calunia_eleitoral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Atribuicao falsa e verificavel de fato definido como crime a pessoa no contexto eleitoral, apresentada como verdadeira.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Calúnia Eleitoral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <skos:definition xml:lang="pt-BR">Atribuicao falsa e verificavel de fato definido como crime a pessoa no contexto eleitoral, apresentada como verdadeira.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calunia_eleitoral</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Calúnia Eleitoral</skos:prefLabel>
    <syn:alvoTipico rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Candidato, agente politico ou pessoa vinculada ao processo eleitoral.</syn:alvoTipico>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Opiniao, insulto sem fato criminoso, acusacao comprovada ou relato fiel de processo existente.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha imputacao factual falsa de crime com potencial de dano reputacional eleitoral.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Atribuicao falsa e verificavel de fato definido como crime a pessoa no contexto eleitoral, apresentada como verdadeira.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:requerAvaliacaoDeVeracidade rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Calúnia Eleitoral</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_descontextualizado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo real associado a evento, periodo, local ou pessoa diferentes daqueles em que foi produzido.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Conteúdo Descontextualizado</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Conteudo real associado a evento, periodo, local ou pessoa diferentes daqueles em que foi produzido.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conteudo_descontextualizado</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Conteúdo Descontextualizado</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O contexto atribuido corresponde ao original ou a incerteza e explicitamente comunicada.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O artefato autentico recebe atribuicao factual de origem, tempo, local ou autoria comprovadamente diferente.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo real associado a evento, periodo, local ou pessoa diferentes daqueles em que foi produzido.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">categoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/categoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteúdo Descontextualizado</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo com original autentico que foi materialmente alterado para mudar seu significado ou induzir interpretacao enganosa.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Conteúdo Manipulado</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Conteudo com original autentico que foi materialmente alterado para mudar seu significado ou induzir interpretacao enganosa.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conteudo_manipulado</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Conteúdo Manipulado</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ajuste cosmetico, edicao transparente, parodia marcada ou ausencia de mudanca de sentido.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Existe original autentico e alteracao tecnica material que modifica a mensagem.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo com original autentico que foi materialmente alterado para mudar seu significado ou induzir interpretacao enganosa.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supercategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/supercategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteúdo Manipulado</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo criado algoritmicamente sem captura autentica correspondente do evento, pessoa, voz ou cena representada.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Conteúdo Sintético</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Conteudo criado algoritmicamente sem captura autentica correspondente do evento, pessoa, voz ou cena representada.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conteudo_sintetico</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Conteúdo Sintético</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Captura real, edicao de original autentico ou obra humana sem representacao enganosa de evento real.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha evidencia de geracao algoritmica integral ou ausencia de original autentico.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo criado algoritmicamente sem captura autentica correspondente do evento, pessoa, voz ou cena representada.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supercategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/supercategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteúdo Sintético</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Unidade de analise cujo tema, uso ou contexto relevante envolve eleicoes, atores eleitorais, instituicoes democraticas ou processos de votacao.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Conteúdo de tema eleitoral</rdfs:label>
    <skos:definition xml:lang="pt-BR">Unidade de analise cujo tema, uso ou contexto relevante envolve eleicoes, atores eleitorais, instituicoes democraticas ou processos de votacao.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conteudo_tema_eleitoral</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Conteúdo de tema eleitoral</skos:prefLabel>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unidade de analise cujo tema, uso ou contexto relevante envolve eleicoes, atores eleitorais, instituicoes democraticas ou processos de votacao.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Contexto estrutural: use para explicar a posição hierárquica, mas não o retorne como categoria operacional.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural_context</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">raiz</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_structural_context_only>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/raiz" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteúdo de tema eleitoral</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/estrutural" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/contexto_ausente">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo autentico divulgado sem informacoes necessarias de data, local, circunstancia ou finalidade, produzindo interpretacao enganosa.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Contexto Ausente</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Conteudo autentico divulgado sem informacoes necessarias de data, local, circunstancia ou finalidade, produzindo interpretacao enganosa.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contexto_ausente</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Contexto Ausente</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O contexto omitido e irrelevante para a interpretacao ou esta disponivel de modo claro.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ausencia de contexto indispensavel leva a conclusao materialmente diferente da leitura contextualizada.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo autentico divulgado sem informacoes necessarias de data, local, circunstancia ou finalidade, produzindo interpretacao enganosa.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">categoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/categoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contexto Ausente</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/critica_legitima_ou_neutra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Questionamento, analise ou proposta sobre instituicoes e processos eleitorais que permanece dentro do debate democratico e nao promove desinformacao nem ruptura.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Crítica Legítima ou Neutra</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral" />
    <skos:definition xml:lang="pt-BR">Questionamento, analise ou proposta sobre instituicoes e processos eleitorais que permanece dentro do debate democratico e nao promove desinformacao nem ruptura.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critica_legitima_ou_neutra</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Crítica Legítima ou Neutra</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alegacao infundada de fraude, rejeicao da ordem democratica ou incitacao a ruptura.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha critica fundamentada, pergunta aberta, proposta de reforma legal ou educacao civica sem negacao de legitimidade.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Questionamento, analise ou proposta sobre instituicoes e processos eleitorais que permanece dentro do debate democratico e nao promove desinformacao nem ruptura.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">categoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral" />
    <syn:notas rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceito de fronteira do domínio, não subclasse de Discursos Antidemocráticos. ITEMs associados devem usar status excluido ou limite.</syn:notas>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/categoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crítica Legítima ou Neutra</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/fronteira_exclusao" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/descontextualizacao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Trecho autentico de fala, entrevista ou documento apresentado sem partes complementares que alterariam sua interpretacao.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Descontextualização</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Trecho autentico de fala, entrevista ou documento apresentado sem partes complementares que alterariam sua interpretacao.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">descontextualizacao</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Descontextualização</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O excerto e fiel, suficiente e identificado como parcial.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A omissao de trechos adjacentes muda materialmente o sentido da fala ou do documento.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trecho autentico de fala, entrevista ou documento apresentado sem partes complementares que alterariam sua interpretacao.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">categoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/categoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Descontextualização</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conceito agregador para fenomenos de desordem informacional analisados por dimensoes separadas de veracidade e integridade, sem substituir suas classificacoes.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Desinformação</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral" />
    <skos:definition xml:lang="pt-BR">Conceito agregador para fenomenos de desordem informacional analisados por dimensoes separadas de veracidade e integridade, sem substituir suas classificacoes.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">desinformacao</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Desinformação</skos:prefLabel>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceito agregador para fenomenos de desordem informacional analisados por dimensoes separadas de veracidade e integridade, sem substituir suas classificacoes.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Contexto estrutural: use para explicar a posição hierárquica, mas não o retorne como categoria operacional.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural_context</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agregador</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/agregador" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desinformação</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/estrutural" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/difamacao_eleitoral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Imputacao ou divulgacao de fato ofensivo a reputacao de pessoa no contexto eleitoral, independentemente de o fato ser verdadeiro.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Difamação Eleitoral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <skos:definition xml:lang="pt-BR">Imputacao ou divulgacao de fato ofensivo a reputacao de pessoa no contexto eleitoral, independentemente de o fato ser verdadeiro.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">difamacao_eleitoral</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Difamação Eleitoral</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Critica de desempenho publico, informacao de interesse publico tratada sem humilhacao ou imputacao falsa de crime.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha publicizacao de fato ofensivo com finalidade ou efeito de degradar reputacao eleitoral.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imputacao ou divulgacao de fato ofensivo a reputacao de pessoa no contexto eleitoral, independentemente de o fato ser verdadeiro.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Difamação Eleitoral</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo que ataca deliberadamente honra, reputacao, dignidade ou direitos de pessoas ou grupos no contexto eleitoral.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Discurso de Ódio Eleitoral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral" />
    <skos:definition xml:lang="pt-BR">Conteudo que ataca deliberadamente honra, reputacao, dignidade ou direitos de pessoas ou grupos no contexto eleitoral.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discurso_de_odio_eleitoral</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Discurso de Ódio Eleitoral</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Critica de politica publica, competencia, ato documentado, satira marcada ou discordancia ideologica sem ataque a dignidade.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha ataque pessoal ou coletivo relacionado a disputa eleitoral, com dano reputacional, humilhacao ou incitacao discriminatoria.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo que ataca deliberadamente honra, reputacao, dignidade ou direitos de pessoas ou grupos no contexto eleitoral.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supercategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/supercategoria" />
    <syn:perguntaOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O conteudo ataca deliberadamente a honra, a reputacao ou a dignidade de pessoa ou grupo no contexto eleitoral?</syn:perguntaOperacional>
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Discurso de Ódio Eleitoral</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo que fragiliza ou desacredita instituicoes democraticas, nega legitimidade eleitoral ou incita ruptura da ordem democratica.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Discursos Antidemocráticos</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral" />
    <skos:definition xml:lang="pt-BR">Conteudo que fragiliza ou desacredita instituicoes democraticas, nega legitimidade eleitoral ou incita ruptura da ordem democratica.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discursos_antidemocraticos</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Discursos Antidemocráticos</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Critica institucional fundamentada, proposta de reforma democratica, educacao civica, investigacao legitima ou satira identificada.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha funcao de erosao de confianca institucional, negacao de legitimidade ou incitacao a acao antidemocratica.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo que fragiliza ou desacredita instituicoes democraticas, nega legitimidade eleitoral ou incita ruptura da ordem democratica.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supercategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/supercategoria" />
    <syn:perguntaOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O conteudo enfraquece a confianca democratica, nega legitimidade eleitoral ou incita ruptura institucional?</syn:perguntaOperacional>
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Discursos Antidemocráticos</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Recorte tematico que organiza categorias de conteudo nocivo relacionadas a eleicoes, disputa politica, processo de votacao e legitimidade democratica.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Domínio Eleitoral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral" />
    <skos:definition xml:lang="pt-BR">Recorte tematico que organiza categorias de conteudo nocivo relacionadas a eleicoes, disputa politica, processo de votacao e legitimidade democratica.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dominio_eleitoral</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Domínio Eleitoral</skos:prefLabel>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recorte tematico que organiza categorias de conteudo nocivo relacionadas a eleicoes, disputa politica, processo de votacao e legitimidade democratica.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Contexto estrutural: use para explicar a posição hierárquica, mas não o retorne como categoria operacional.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural_context</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dominio</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/dominio" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Domínio Eleitoral</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/estrutural" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/editado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Video ou audio autentico rearranjado, acrescido ou reorganizado para alterar a sequencia, fala ou narrativa.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Editado</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado" />
    <skos:definition xml:lang="pt-BR">Video ou audio autentico rearranjado, acrescido ou reorganizado para alterar a sequencia, fala ou narrativa.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">editado</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Editado</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edicao tecnica neutra ou transparente que preserva o significado.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A edicao remove, adiciona ou reorganiza elementos de modo material para mudar o sentido.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Video ou audio autentico rearranjado, acrescido ou reorganizado para alterar a sequencia, fala ou narrativa.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Editado</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/extremismo_antidemocratico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo que rejeita regras e instituicoes democraticas e promove ruptura sistemica, golpe, intervencao ou violencia politica.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Extremismo Antidemocrático</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <skos:definition xml:lang="pt-BR">Conteudo que rejeita regras e instituicoes democraticas e promove ruptura sistemica, golpe, intervencao ou violencia politica.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extremismo_antidemocratico</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Extremismo Antidemocrático</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Critica de decisao ou instituicao dentro do marco constitucional e proposta democratica de reforma.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha defesa explicita de golpe, dissolucao institucional, intervencao militar, estado de excecao ou violencia contra a ordem democratica.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo que rejeita regras e instituicoes democraticas e promove ruptura sistemica, golpe, intervencao ou violencia politica.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <syn:mecanismoDeDano rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subversao das instituicoes e normalizacao de ruptura autoritaria.</syn:mecanismoDeDano>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extremismo Antidemocrático</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Dimensao transversal que gradua a clareza com que um conteudo configura ilicito verificavel, sem substituir avaliacao juridica formal.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Ilicitude no Ambiente Digital</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral" />
    <skos:definition xml:lang="pt-BR">Dimensao transversal que gradua a clareza com que um conteudo configura ilicito verificavel, sem substituir avaliacao juridica formal.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ilicitude_no_ambiente_digital</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Ilicitude no Ambiente Digital</skos:prefLabel>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dimensao transversal que gradua a clareza com que um conteudo configura ilicito verificavel, sem substituir avaliacao juridica formal.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Contexto estrutural: use para explicar a posição hierárquica, mas não o retorne como categoria operacional.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural_context</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dimensao</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_tema_eleitoral" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/dimensao" />
    <syn:perguntaOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qual e o grau de confirmacao juridica ou tecnica da ilicitude?</syn:perguntaOperacional>
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ilicitude no Ambiente Digital</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/estrutural" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/imagem_sintetica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Imagem, fotografia, ilustracao ou grafico gerado por IA sem correspondencia autentica com a cena apresentada.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Imagem Sintética</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <skos:definition xml:lang="pt-BR">Imagem, fotografia, ilustracao ou grafico gerado por IA sem correspondencia autentica com a cena apresentada.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">imagem_sintetica</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Imagem Sintética</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fotografia real, montagem baseada em fotografia ou arte identificada como ficcao.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A imagem foi gerada algoritmicamente e representa como real uma composicao sem captura correspondente.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imagem, fotografia, ilustracao ou grafico gerado por IA sem correspondencia autentica com a cena apresentada.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_observable_signal xml:lang="pt-BR">Geometria impossivel</syn:graph_rag_observable_signal>
    <syn:graph_rag_observable_signal xml:lang="pt-BR">padroes repetitivos e inconsistencias de reflexo.</syn:graph_rag_observable_signal>
    <syn:graph_rag_observable_signal xml:lang="pt-BR">tipografia ilegivel</syn:graph_rag_observable_signal>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imagem Sintética</syn:rotuloPreferido>
    <syn:sinaisObservaveis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geometria impossivel, tipografia ilegivel, padroes repetitivos e inconsistencias de reflexo.</syn:sinaisObservaveis>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/inconclusivo_ilicitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Conteudo cuja ilicitude nao pode ser determinada por ambiguidade de intencao, contexto ou norma aplicavel.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Inconclusivo quanto à Ilicitude</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <skos:definition xml:lang="pt-BR">Conteudo cuja ilicitude nao pode ser determinada por ambiguidade de intencao, contexto ou norma aplicavel.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inconclusivo_ilicitude</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Inconclusivo quanto à Ilicitude</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha preponderancia clara em favor de ilicitude ou licitude.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha zona cinzenta juridica ou evidencia insuficiente para decidir.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conteudo cuja ilicitude nao pode ser determinada por ambiguidade de intencao, contexto ou norma aplicavel.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inconclusivo quanto à Ilicitude</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/inconclusivo_integridade_contextual">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">O contexto atribuido ao artefato nao pode ser determinado com as evidencias disponiveis.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Inconclusivo quanto à Integridade Contextual</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_contextual" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_contextual" />
    <skos:definition xml:lang="pt-BR">O contexto atribuido ao artefato nao pode ser determinado com as evidencias disponiveis.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inconclusivo_integridade_contextual</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Inconclusivo quanto à Integridade Contextual</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As evidencias preponderantes correspondem a outro grau do mesmo espectro.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As evidencias disponiveis correspondem ao grau descrito.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O contexto atribuido ao artefato nao pode ser determinado com as evidencias disponiveis.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_contextual" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inconclusivo quanto à Integridade Contextual</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/inconclusivo_integridade_midiatica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Integridade tecnica do artefato nao pode ser determinada com as evidencias disponiveis.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Inconclusivo quanto à Integridade Midiática</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_midiatica" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_midiatica" />
    <skos:definition xml:lang="pt-BR">Integridade tecnica do artefato nao pode ser determinada com as evidencias disponiveis.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inconclusivo_integridade_midiatica</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Inconclusivo quanto à Integridade Midiática</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As evidencias preponderantes correspondem a outro grau do mesmo espectro.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As evidencias disponiveis correspondem ao grau descrito.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integridade tecnica do artefato nao pode ser determinada com as evidencias disponiveis.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_midiatica" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inconclusivo quanto à Integridade Midiática</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/inconclusivo_veracidade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Evidencia insuficiente ou debate em andamento impede determinar a veracidade com seguranca razoavel.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Inconclusivo quanto à Veracidade</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Evidencia insuficiente ou debate em andamento impede determinar a veracidade com seguranca razoavel.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inconclusivo_veracidade</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Inconclusivo quanto à Veracidade</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha preponderancia clara ou comprovacao conclusiva em qualquer direcao.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As evidencias disponiveis sao insuficientes, conflitantes ou ainda estao em investigacao.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evidencia insuficiente ou debate em andamento impede determinar a veracidade com seguranca razoavel.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inconclusivo quanto à Veracidade</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/injuria_eleitoral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Ofensa direta a dignidade ou ao decoro de pessoa no contexto eleitoral, sem necessidade de imputacao factual especifica.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Injúria Eleitoral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <skos:definition xml:lang="pt-BR">Ofensa direta a dignidade ou ao decoro de pessoa no contexto eleitoral, sem necessidade de imputacao factual especifica.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injuria_eleitoral</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Injúria Eleitoral</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Critica de ideias, desempenho ou politicas sem ofensa pessoal a dignidade.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha xingamento, humilhacao ou ridicularizacao dirigida a pessoa identificavel.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ofensa direta a dignidade ou ao decoro de pessoa no contexto eleitoral, sem necessidade de imputacao factual especifica.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Injúria Eleitoral</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_contextual">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Espectro complementar que classifica a autenticidade do contexto atribuido a um artefato.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Espectro de Integridade Contextual</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Espectro complementar que classifica a autenticidade do contexto atribuido a um artefato.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integridade_contextual</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Espectro de Integridade Contextual</skos:prefLabel>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Espectro complementar que classifica a autenticidade do contexto atribuido a um artefato.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Contexto estrutural: use para explicar a posição hierárquica, mas não o retorne como categoria operacional.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural_context</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agregador</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/agregador" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Espectro de Integridade Contextual</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/estrutural" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Dimensao transversal que avalia autenticidade, sintese, manipulacao e adequacao contextual do artefato informacional.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Integridade da Informação</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao" />
    <skos:definition xml:lang="pt-BR">Dimensao transversal que avalia autenticidade, sintese, manipulacao e adequacao contextual do artefato informacional.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integridade_da_informacao</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Integridade da Informação</skos:prefLabel>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dimensao transversal que avalia autenticidade, sintese, manipulacao e adequacao contextual do artefato informacional.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Contexto estrutural: use para explicar a posição hierárquica, mas não o retorne como categoria operacional.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural_context</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dimensao</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/dimensao" />
    <syn:perguntaOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O artefato e seu contexto sao autenticos e nao foram alterados de modo enganoso?</syn:perguntaOperacional>
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integridade da Informação</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/estrutural" />
  </owl:Class>
