  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23760_2026">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Source" />
    <dcterms:description xml:lang="pt-BR">Resolucao do TSE que estabelece o Calendario Eleitoral das Eleições 2026, incluindo datas do primeiro turno (4 de outubro), segundo turno (25 de outubro) e inicio da propaganda eleitoral (16 de agosto).</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resolucao TSE 23.760/2026, Instrucao 0600273-13.2026.6.00.0000</dcterms:identifier>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23760_2026</dcterms:identifier>
    <rdfs:seeAlso rdf:resource="https://www.tse.jus.br/legislacao/compilada/res/2026/resolucao-no-23-760-de-2-de-marco-de-2026" />
    <syn:cicloEleitoral rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026</syn:cicloEleitoral>
    <syn:dataAcesso rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-25</syn:dataAcesso>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fontes/registros/fontes-publicas.syn</syn:declaredIn>
    <syn:descricaoFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resolucao do TSE que estabelece o Calendario Eleitoral das Eleições 2026, incluindo datas do primeiro turno (4 de outubro), segundo turno (25 de outubro) e inicio da propaganda eleitoral (16 de agosto).</syn:descricaoFonte>
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Use para ancorar a interpretação jurídica declarada; não deduza crime, ilicitude, sanção ou veracidade do caso concreto.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_legal_source rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_legal_source>
    <syn:graph_rag_source_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">legal_anchor</syn:graph_rag_source_role>
    <syn:identificadorExterno rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resolucao TSE 23.760/2026, Instrucao 0600273-13.2026.6.00.0000</syn:identificadorExterno>
    <syn:idioma rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portugues</syn:idioma>
