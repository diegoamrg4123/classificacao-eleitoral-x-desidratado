    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23760_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">datas_eleitorais_2026</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As datas do calendario eleitoral definem o contexto temporal aplicavel a janela de silencio digital (72h antes e 24h apos o pleito, conforme a 23.755) e ao periodo de propaganda. Elas nao alteram conceitos, mas sao referencia operacional para avaliar se conteudos sinteticos foram publicados dentro ou fora das vedações temporais.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anexo I</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/ilicito_conteudo_sintetico_res_23757">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 6, paragrafo 4. A utilizacao da internet, inclusive servicos de mensageria, para difundir informacoes falsas ou descontextualizadas em prejuizo de adversaria(o) ou em beneficio de candidata(o), ou a respeito do sistema eletronico de votacao e da Justica Eleitoral, assim como o uso de conteudo sintetico gerado ou modificado por inteligencia artificial ou tecnologias equivalentes em violacao as normas eleitorais, configura uso indevido dos meios de comunicacao e, pelas circunstancias do caso, tambem abuso dos poderes politico e economico.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ilicito_conteudo_sintetico_res_23757</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23757_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 6, paragrafo 4. A utilizacao da internet, inclusive servicos de mensageria, para difundir informacoes falsas ou descontextualizadas em prejuizo de adversaria(o) ou em beneficio de candidata(o), ou a respeito do sistema eletronico de votacao e da Justica Eleitoral, assim como o uso de conteudo sintetico gerado ou modificado por inteligencia artificial ou tecnologias equivalentes em violacao as normas eleitorais, configura uso indevido dos meios de comunicacao e, pelas circunstancias do caso, tambem abuso dos poderes politico e economico.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23757_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/acusacao_de_fraude_institucional" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23757_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ilicito_conteudo_sintetico_res_23757</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O dispositivo e a norma que fecha o circuito regulatório: conteudo sintetico em violacao a normas eleitorais configura ilicito eleitoral. Alem disso, mantiem a tipificacao de difusao de informacoes falsas ou descontextualizadas sobre o sistema eletronico de votacao e a Justica Eleitoral. Ambas as hipoteses reforcam a avaliacao de ilicitude para conteudos que atacam o sistema ou difundem falsidades, sem transformar toda classificacao em conclusao automatica de crime.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 6, paragrafo 4</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/includefensoria_fiscalizadoras_res_23758">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">A Resolucao 23.758/2026 inclui a Defensoria Publica entre as entidades fiscalizadoras do sistema eletronico de votacao, ao lado do Ministerio Publico, partidos, federacoes, OAB, Forcas Armadas e demais orgaos previstos no art. 6.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">includefensoria_fiscalizadoras_res_23758</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23758_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Resolucao 23.758/2026 inclui a Defensoria Publica entre as entidades fiscalizadoras do sistema eletronico de votacao, ao lado do Ministerio Publico, partidos, federacoes, OAB, Forcas Armadas e demais orgaos previstos no art. 6.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23758_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/critica_legitima_ou_neutra" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23758_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">includefensoria_fiscalizadoras_res_23758</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ampliacao do rol de entidades fiscalizadoras inclui orgao de defesa de direitos fundamentais. Isso reforca que a fiscalizacao das urnas nao e controlada por um unico ator institucional e que criticas tecnicas feitas por orgaos legitimados constitucionalmente nao devem ser confundidas com ataques infundados ao sistema.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 6, III-A</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/inversao_onus_prova_res_23755">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 9-I. Nas representacoes que versem sobre o uso de conteudo sintetico gerado por inteligencia artificial ou por tecnologia equivalente que apurem violacoes aos arts. 9-B, 9-C, 9-D e 9-E desta Resolucao, o juiz podera, motivadamente, inverter o onus da prova quando, em razao da dificuldade tecnica de comprovacao da manipulacao digital, for excessivamente oneroso ao autor demonstrar a irregularidade do conteudo.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inversao_onus_prova_res_23755</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9-I. Nas representacoes que versem sobre o uso de conteudo sintetico gerado por inteligencia artificial ou por tecnologia equivalente que apurem violacoes aos arts. 9-B, 9-C, 9-D e 9-E desta Resolucao, o juiz podera, motivadamente, inverter o onus da prova quando, em razao da dificuldade tecnica de comprovacao da manipulacao digital, for excessivamente oneroso ao autor demonstrar a irregularidade do conteudo.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23755_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inversao_onus_prova_res_23755</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A inversao motivada do onus da prova em casos de conteudo sintetico reforca que o grau de comprovacao tecnica pode variar conforme as circunstancias. Isso interage com o campo confianca do ITEM e com a dimensao de Veracidade, pois a dificuldade de demonstrar manipulacao nao decide automaticamente o valor da veracidade.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9-I</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/janela_silencio_digital_res_23755">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 9-B, paragrafo 3-A. Ficam vedadas a publicacao e a republicacao, ainda que gratuitas, bem como o impulsionamento pago de novos conteudos sinteticos produzidos ou alterados por inteligencia artificial ou por tecnologias equivalentes que utilizem imagem, voz ou manifestacao de candidata ou candidato ou de pessoa publica, mesmo que rotulados e em conformidade com as demais exigencias deste artigo, no periodo compreendido entre as 72 horas que antecedem e as 24 horas que sucedem o termino do pleito.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">janela_silencio_digital_res_23755</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9-B, paragrafo 3-A. Ficam vedadas a publicacao e a republicacao, ainda que gratuitas, bem como o impulsionamento pago de novos conteudos sinteticos produzidos ou alterados por inteligencia artificial ou por tecnologias equivalentes que utilizem imagem, voz ou manifestacao de candidata ou candidato ou de pessoa publica, mesmo que rotulados e em conformidade com as demais exigencias deste artigo, no periodo compreendido entre as 72 horas que antecedem e as 24 horas que sucedem o termino do pleito.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23755_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">janela_silencio_digital_res_23755</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O dispositivo cria uma janela de silencio digital que proibe novos conteudos sinteticos com imagem, voz ou manifestacao de candidaturas e pessoas publicas nas 72h antes e 24h apos o pleito, mesmo rotulados. Sustenta o criterio temporal como componente de avaliacao de ilicitude para conteudo sintetico em periodo critico.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9-B, paragrafo 3-A</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/limite_enfrentamento_desinformacao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 2. As medidas para o enfrentamento da desinformacao que atente contra a integridade do processo eleitoral serao realizadas nos termos da legislacao de regencia e de resolucao deste Tribunal Superior.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_enfrentamento_desinformacao</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23757_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 2. As medidas para o enfrentamento da desinformacao que atente contra a integridade do processo eleitoral serao realizadas nos termos da legislacao de regencia e de resolucao deste Tribunal Superior.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23757_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23757_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_enfrentamento_desinformacao</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O artigo reafirma que o enfrentamento da desinformacao segue o marco normativo do TSE, nao decisoes ad hoc. Sustenta a fronteira: a ontologia define categorias operacionais, nao poder punitivo autonomo. A avaliacao de ilicitude depende de contexto, norma e revisao especializada.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 2</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/limite" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/limite_legal_ce_fato_inveridico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 323. Divulgar, na propaganda eleitoral ou durante periodo de campanha eleitoral, fatos que sabe inveridicos em relacao a partidos ou candidatos e capazes de exercer influencia perante o eleitorado.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_ce_fato_inveridico</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/codigo_eleitoral_1965" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 323. Divulgar, na propaganda eleitoral ou durante periodo de campanha eleitoral, fatos que sabe inveridicos em relacao a partidos ou candidatos e capazes de exercer influencia perante o eleitorado.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codigo_eleitoral_1965</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/calunia_eleitoral" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/codigo_eleitoral_1965" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_ce_fato_inveridico</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O artigo delimita que divulgacao de fato sabidamente inveridico e influente no eleitorado nao e sinonimo automatico de calunia, que exige imputacao falsa de fato definido como crime.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 323</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/limite" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/limite_legal_cp_critica_e_manifestacao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 359-T. Nao constitui crime previsto neste Titulo a manifestacao critica aos poderes constitucionais nem a atividade jornalistica ou a reivindicacao de direitos e garantias constitucionais por meio de manifestacao politica com propositos sociais.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_cp_critica_e_manifestacao</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/codigo_penal_1940" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 359-T. Nao constitui crime previsto neste Titulo a manifestacao critica aos poderes constitucionais nem a atividade jornalistica ou a reivindicacao de direitos e garantias constitucionais por meio de manifestacao politica com propositos sociais.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codigo_penal_1940</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/critica_legitima_ou_neutra" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/codigo_penal_1940" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_cp_critica_e_manifestacao</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O artigo estabelece fronteira expressa para critica aos Poderes, atividade jornalistica e reivindicacao social, impedindo que a categoria operacional seja usada para rotular automaticamente dissenso ou protesto legitimo.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 359-T</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/limite" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/limite_legal_cp_seguranca_sistema_eleitoral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 359-N. Impedir ou perturbar a eleicao ou a afericao de seu resultado, mediante violacao indevida de mecanismos de seguranca do sistema eletronico de votacao estabelecido pela Justica Eleitoral.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_cp_seguranca_sistema_eleitoral</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/codigo_penal_1940" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 359-N. Impedir ou perturbar a eleicao ou a afericao de seu resultado, mediante violacao indevida de mecanismos de seguranca do sistema eletronico de votacao estabelecido pela Justica Eleitoral.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codigo_penal_1940</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/codigo_penal_1940" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_cp_seguranca_sistema_eleitoral</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O tipo protege a eleicao contra interferencia material ou tecnologica nos mecanismos de seguranca, mas nao criminaliza isoladamente alegacao discursiva sobre urnas. Ele funciona como fronteira juridica, nao como sinonimo da categoria operacional.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 359-N</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/limite" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/limite_legal_lc64_abuso_e_gravidade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">O art. 22 permite investigar uso indevido, desvio ou abuso do poder economico ou de autoridade, ou utilizacao indevida de veiculos ou meios de comunicacao social, em beneficio de candidato ou de partido politico.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_lc64_abuso_e_gravidade</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lc_64_1990" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O art. 22 permite investigar uso indevido, desvio ou abuso do poder economico ou de autoridade, ou utilizacao indevida de veiculos ou meios de comunicacao social, em beneficio de candidato ou de partido politico.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lc_64_1990</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/acusacao_de_fraude_institucional" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lc_64_1990" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_lc64_abuso_e_gravidade</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A norma explica a necessidade de analisar contexto eleitoral, beneficio, meio de circulacao, prova e gravidade antes de concluir por abuso ou sancao. Ela nao transforma a classificacao operacional em ilicito eleitoral automatico.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 22</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/limite" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/limite_legal_lei_13834_denunciacao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 326-A. Dar causa a instauracao de investigacao policial, processo judicial, investigacao administrativa, inquerito civil ou acao de improbidade, atribuindo crime ou ato infracional a pessoa que se sabe inocente, com finalidade eleitoral.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_lei_13834_denunciacao</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lei_13834_2019" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 326-A. Dar causa a instauracao de investigacao policial, processo judicial, investigacao administrativa, inquerito civil ou acao de improbidade, atribuindo crime ou ato infracional a pessoa que se sabe inocente, com finalidade eleitoral.</syn:conteudo>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lei_13834_2019</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/calunia_eleitoral" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lei_13834_2019" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_legal_lei_13834_denunciacao</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O tipo delimita a denuncicao caluniosa com finalidade eleitoral como figura distinta da categoria de calunia eleitoral atualmente materializada na ontologia.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 2, art. 326-A do Codigo Eleitoral</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/limite" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/limite_res_23755_deepfake">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 9-C, paragrafo 1. Vedado o uso, para prejudicar ou favorecer candidatura, de conteudo sintetico em audio ou video gerado ou manipulado para criar, substituir ou alterar imagem ou voz de pessoa viva, falecida ou ficticia, ainda que mediante autorizacao.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_res_23755_deepfake</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9-C, paragrafo 1. Vedado o uso, para prejudicar ou favorecer candidatura, de conteudo sintetico em audio ou video gerado ou manipulado para criar, substituir ou alterar imagem ou voz de pessoa viva, falecida ou ficticia, ainda que mediante autorizacao.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23755_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limite_res_23755_deepfake</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O dispositivo estabelece fronteira entre conteudo sintetico permitido (com transparencia) e conteudo sintetico proibido (deepfake), incluindo pessoas vivas, falecidas e ficticias. A proibicao vale independentemente de autorizacao e de qualidade tecnica. O ITEM registra a fronteira de exclusao direta da permissao com rotulagem.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9-C, paragrafo 1</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/limite" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/portaria_463_escopo_provedores">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">O plano de conformidade devera ser apresentado por provedores de aplicacao que disponibilizem servicos de aplicacao de internet que desempenhem funcao relevante na producao, difusao, organizacao, recomendacao, moderacao ou impulsionamento de conteudo politico-eleitoral, incluindo, expressamente, provedores com funcionalidade de geracao de conteudo sintetico por inteligencia artificial generativa, em regra com mais de cinco milhoes de usuarios ativos mensais no Brasil.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portaria_463_escopo_provedores</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O plano de conformidade devera ser apresentado por provedores de aplicacao que disponibilizem servicos de aplicacao de internet que desempenhem funcao relevante na producao, difusao, organizacao, recomendacao, moderacao ou impulsionamento de conteudo politico-eleitoral, incluindo, expressamente, provedores com funcionalidade de geracao de conteudo sintetico por inteligencia artificial generativa, em regra com mais de cinco milhoes de usuarios ativos mensais no Brasil.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-27</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portaria_tse_463_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portaria_463_escopo_provedores</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portaria regulamenta quem deve apresentar plano de conformidade e define obrigatoriedade para provedores com IA generativa e grande base de usuarios. Isso sustenta o criterio de governanca de plataformas como componente de avaliacao de ilicitude: provedores com alcance significativo tem deveres reforcados de fiscalizar conteudo sintetico.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arts. 2 e 3</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/portaria_463_obrigacoes_ia_generativa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Para sistemas de inteligencia artificial generativa, chatbots e assistentes automatizados, o plano de conformidade deve apontar salvaguardas tecnicas que impecam os sistemas de opinar, comentar ou gerar conteudos que favorecam candidaturas ou contenham recomendacao de voto. O plano deve incluir mecanismos contra tentativas de contorno, rotulagem em publicacoes organicas e testes periodicos de resistencia.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portaria_463_obrigacoes_ia_generativa</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Para sistemas de inteligencia artificial generativa, chatbots e assistentes automatizados, o plano de conformidade deve apontar salvaguardas tecnicas que impecam os sistemas de opinar, comentar ou gerar conteudos que favorecam candidaturas ou contenham recomendacao de voto. O plano deve incluir mecanismos contra tentativas de contorno, rotulagem em publicacoes organicas e testes periodicos de resistencia.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-27</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portaria_tse_463_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portaria_463_obrigacoes_ia_generativa</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portaria detalha as obrigacoes de provedores de IA generativa, incluindo exigencia de salvaguardas tecnicas contra opiniao politica, teste periodico de resistencia e mecanismos contra contorno. Sustenta o criterio operacional de que ferramentas de IA devem funcionar como infraestrutura neutra, nao como atores eleitorais, e que o descumprimento reforca a avaliacao de ilicitude.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 2, paragrafo unico, e artigos correlatos</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/portaria_463_prazos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">O plano de conformidade deve ser apresentado ate o dia 16 de agosto de 2026. Deve ser atualizado em ate 48 horas diante de alteracao substancial de risco e o provedor deve comunicar risco extraordinario a integridade do processo em ate 3 dias. O relatorio consolidado de implementacao deve ser entregue ate 19 de dezembro de 2026.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portaria_463_prazos</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O plano de conformidade deve ser apresentado ate o dia 16 de agosto de 2026. Deve ser atualizado em ate 48 horas diante de alteracao substancial de risco e o provedor deve comunicar risco extraordinario a integridade do processo em ate 3 dias. O relatorio consolidado de implementacao deve ser entregue ate 19 de dezembro de 2026.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-27</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portaria_tse_463_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portaria_463_prazos</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Os prazos da portaria estabelecem um ciclo de conformidade: entrega (16/ago), atualizacao (48h), risco extraordinario (3 dias) e relatorio final (19/dez). Sustenta o criterio de temporalidade como componente de avaliacao de ilicitude: o descumprimento dos prazos ou a ausencia de plano configuram circunstancia agravante na avaliacao normativa.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 24</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/remocao_perfis_res_23755">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 38-A. A remocao de perfil sera feita quando se tratar de usuario com perfil falso, automatizado ou robo, e a exclusao pelos provedores de aplicacao e permitida apenas nessas hipoteses.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">remocao_perfis_res_23755</dcterms:identifier>
