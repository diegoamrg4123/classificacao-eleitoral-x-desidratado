    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Artefato claramente sintetizado ou substancialmente editado, confirmado por analise tecnica, origem ou evidencia perceptual robusta.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_midiatica" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Notoriamente Sintético ou Manipulado</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/notoriamente_veridico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Fato comprovado por consenso entre fontes confiaveis, sem controversia razoavel.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Notoriamente Verídico</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <skos:definition xml:lang="pt-BR">Fato comprovado por consenso entre fontes confiaveis, sem controversia razoavel.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">notoriamente_veridico</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Notoriamente Verídico</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apenas preponderancia parcial, debate legitimo ou ausencia de verificacao conclusiva.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evidencia independente e convergente confirma a afirmacao.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fato comprovado por consenso entre fontes confiaveis, sem controversia razoavel.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Notoriamente Verídico</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/odio_direcionado_a_grupos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">Ataque a grupo protegido por caracteristica identitaria, demografica ou pertencimento politico reconhecido, no contexto eleitoral.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Discurso de Ódio Direcionado a Grupos</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <skos:definition xml:lang="pt-BR">Ataque a grupo protegido por caracteristica identitaria, demografica ou pertencimento politico reconhecido, no contexto eleitoral.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">odio_direcionado_a_grupos</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Discurso de Ódio Direcionado a Grupos</skos:prefLabel>
    <syn:alvoTipico rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grupos raciais, religiosos, de genero, sexualidade, origem ou pertencimento politico.</syn:alvoTipico>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mencao factual, critica de politica ou denuncia de discriminacao sem ataque ao grupo. Tambem fica de fora o ataque a grupos definidos apenas por ocupacao, atividade, profissao, torcida, time ou preferencia (ex.: youtubers, streamers, influencers, jogadores, programadores), ainda que a critica seja politica: esses casos usam injuria_eleitoral quando ha pessoa identificavel, ou nenhum conceito quando ha apenas posicao ou opiniao.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ha generalizacao ofensiva, desumanizacao, discriminacao ou incitacao contra grupo protegido por caracteristica identitaria, demografica, religiosa, de genero, sexualidade, origem ou pertencimento politico.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ataque a grupo protegido por caracteristica identitaria, demografica ou pertencimento politico reconhecido, no contexto eleitoral.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcategoria</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral" />
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Discurso de Ódio Direcionado a Grupos</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/provavelmente_contextualizado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#OntologyConcept" />
    <rdfs:comment xml:lang="pt-BR">O contexto parece correto e nao ha indicador relevante de descontextualizacao, mas falta confirmacao primaria.</rdfs:comment>
    <rdfs:label xml:lang="pt-BR">Provavelmente Contextualizado</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_contextual" />
    <skos:broader rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_contextual" />
    <skos:definition xml:lang="pt-BR">O contexto parece correto e nao ha indicador relevante de descontextualizacao, mas falta confirmacao primaria.</skos:definition>
    <skos:inScheme rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology" />
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">provavelmente_contextualizado</skos:notation>
    <skos:prefLabel xml:lang="pt-BR">Provavelmente Contextualizado</skos:prefLabel>
    <syn:criterioExclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As evidencias preponderantes correspondem a outro grau do mesmo espectro.</syn:criterioExclusao>
    <syn:criterioInclusao rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As evidencias disponiveis correspondem ao grau descrito.</syn:criterioInclusao>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontologia/dominio-eleitoral.syno</syn:declaredIn>
    <syn:definicaoOperacional rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O contexto parece correto e nao ha indicador relevante de descontextualizacao, mas falta confirmacao primaria.</syn:definicaoOperacional>
    <syn:graph_rag_classification_guidance xml:lang="pt-BR">Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão.</syn:graph_rag_classification_guidance>
    <syn:graph_rag_classification_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational_candidate</syn:graph_rag_classification_role>
    <syn:graph_rag_hierarchy_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valor_escala</syn:graph_rag_hierarchy_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:graph_rag_structural_context_only rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_structural_context_only>
    <syn:hasParentConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_contextual" />
    <syn:ordemEscala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:ordemEscala>
    <syn:papelHierarquico rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala" />
    <syn:rotuloPreferido rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provavelmente Contextualizado</syn:rotuloPreferido>
    <syn:tipoConceito rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio" />
  </owl:Class>
  <owl:Class rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/provavelmente_descontextualizado">
