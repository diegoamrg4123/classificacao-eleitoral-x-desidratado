    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 140 - Injuriar alguem, ofendendo-lhe a dignidade ou o decoro.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_cp_injuria</dcterms:identifier>
