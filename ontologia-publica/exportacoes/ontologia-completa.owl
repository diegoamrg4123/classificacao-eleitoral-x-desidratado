    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">remocao_perfis_res_23755</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O dispositivo delimita o alcance da remocao de perfis: apenas perfis falsos, automatizados ou robo, em pratica reiterada. Sustenta fronteira entre moderacao aceitavel (remocao de bot) e moderacao que exige avaliacao judicial (remocao de perfil real). Relevante para avaliar resposta de plataformas a conteudos sinteticos que circulam sem responsavel identificavel.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 38-A</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/res_23755_rotulagem_conteudo_sintetico">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 9-B. A utilizacao na propaganda eleitoral, em qualquer modalidade, de conteudo sintetico multimidia gerado por meio de inteligencia artificial ou tecnologia equivalente para criar, substituir, omitir, mesclar ou alterar a velocidade ou sobrepor imagens ou sons, impoe ao responsavel pela propaganda o dever de informar, de modo explicito, destacado e acessivel, que o conteudo foi fabricado ou manipulado e qual tecnologia foi utilizada.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">res_23755_rotulagem_conteudo_sintetico</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9-B. A utilizacao na propaganda eleitoral, em qualquer modalidade, de conteudo sintetico multimidia gerado por meio de inteligencia artificial ou tecnologia equivalente para criar, substituir, omitir, mesclar ou alterar a velocidade ou sobrepor imagens ou sons, impoe ao responsavel pela propaganda o dever de informar, de modo explicito, destacado e acessivel, que o conteudo foi fabricado ou manipulado e qual tecnologia foi utilizada.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23755_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">res_23755_rotulagem_conteudo_sintetico</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O artigo define operacionalmente o que e conteudo sintetico em contexto eleitoral e estabelece o dever de rotulagem. Ele ancora a categoria de conteudo sintetico e seus filhos (imagem, video e audio sinteticos) com vinculo normativo direto, sem converter a classificacao em conclusao de ilicitude.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 9-B</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/teste_biometria_res_23758">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">A Resolucao 23.758/2026 acrescenta o Teste de Integridade com Biometria ao rol de auditorias do sistema eletronico de votacao. O teste e realizado em locais de votacao, com eleitoras e eleitores voluntarios que consentem com a utilizacao de suas biometrias para a habilitacao da urna eletronica.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teste_biometria_res_23758</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23758_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Resolucao 23.758/2026 acrescenta o Teste de Integridade com Biometria ao rol de auditorias do sistema eletronico de votacao. O teste e realizado em locais de votacao, com eleitoras e eleitores voluntarios que consentem com a utilizacao de suas biometrias para a habilitacao da urna eletronica.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23758_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23758_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">teste_biometria_res_23758</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A inclusao de um teste publico de integridade com biometria de eleitores reforca o argumento de que o sistema eletronico de votacao dispoe de mecanismos de verificacao em evolucao. Sustenta a fronteira entre critica tecnica documentada e alegacao conclusiva de fraude, pois o objeto criticado continua contando com auditorias institucionais amplas e, agora, com participacao direta do eleitor.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arts. 2, XVI-A, XVI-B, 53-A</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/vedacao_ia_ator_eleitoral_res_23755">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <rdf:type rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#Item" />
    <dcterms:description xml:lang="pt-BR">Art. 28, paragrafo 1-C. E vedado aos provedores de aplicacao que ofertem sistemas de inteligencia artificial ou por tecnologia equivalente: I - ranquear, recomendar, sugerir ou priorizar candidatas/os, campanhas, partidos politicos, federacoes ou coligacoes; II - emitir opinioes, indicar preferencia eleitoral, recomendar voto ou realizar qualquer forma de favorecimento ou desfavorecimento politico-eleitoral, inclusive por meio de respostas automatizadas.</dcterms:description>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vedacao_ia_ator_eleitoral_res_23755</dcterms:identifier>
    <dcterms:source rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:confianca rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</syn:confianca>
    <syn:conteudo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 28, paragrafo 1-C. E vedado aos provedores de aplicacao que ofertem sistemas de inteligencia artificial ou por tecnologia equivalente: I - ranquear, recomendar, sugerir ou priorizar candidatas/os, campanhas, partidos politicos, federacoes ou coligacoes; II - emitir opinioes, indicar preferencia eleitoral, recomendar voto ou realizar qualquer forma de favorecimento ou desfavorecimento politico-eleitoral, inclusive por meio de respostas automatizadas.</syn:conteudo>
    <syn:dataOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-02</syn:dataOcorrencia>
    <syn:declaredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">itens/evidencias-publicas.syn</syn:declaredIn>
    <syn:formaRegistro rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal" />
    <syn:funcaoItem rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual" />
    <syn:graph_rag_citation_guidance xml:lang="pt-BR">Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão.</syn:graph_rag_citation_guidance>
    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolucao_tse_23755_2026</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico" />
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vedacao_ia_ator_eleitoral_res_23755</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O dispositivo define fronteira: ferramenta de IA generativa nao pode atuar como ator eleitoral. A vedacao de recomendar, ranquear ou emitir preferencia por respostas automatizadas distingue ferramenta neutra de ferramenta que interfere no processo. Sustenta criterio de inclusao para avaliacao de ilicitude em uso de IA por provedores.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 28, paragrafo 1-C, I e II</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
    <syn:statusRevisao rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente" />
    <syn:tipoMidia rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto" />
  </rdf:Description>
