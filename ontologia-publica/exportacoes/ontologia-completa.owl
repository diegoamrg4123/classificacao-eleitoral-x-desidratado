    <syn:graph_rag_citation_source_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codigo_eleitoral_1965</syn:graph_rag_citation_source_id>
    <syn:graph_rag_evidence_review_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pendente</syn:graph_rag_evidence_review_status>
    <syn:graph_rag_evidence_reviewed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</syn:graph_rag_evidence_reviewed>
    <syn:graph_rag_evidence_role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evidencia_conceitual</syn:graph_rag_evidence_role>
    <syn:graph_rag_human_review_required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</syn:graph_rag_human_review_required>
    <syn:hasConcept rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/calunia_eleitoral" />
    <syn:hasSource rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/codigo_eleitoral_1965" />
    <syn:identificadorOcorrencia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">base_legal_ce_calunia</syn:identificadorOcorrencia>
    <syn:justificativa rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O tipo eleitoral especifica que a imputacao falsa de crime deve ocorrer na propaganda eleitoral ou visar a seus fins para receber enquadramento eleitoral.</syn:justificativa>
    <syn:localizacaoNaFonte rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 324</syn:localizacaoNaFonte>
    <syn:statusEnquadramento rdf:resource="https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido" />
