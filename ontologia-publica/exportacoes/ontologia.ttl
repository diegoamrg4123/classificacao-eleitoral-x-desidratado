<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/datas_eleitorais_2026>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "O Calendario Eleitoral das Eleições 2026 fixa o primeiro turno em 4 de outubro e o segundo turno em 25 de outubro. A propaganda eleitoral inicia-se em 16 de agosto de 2026."@pt-BR ;
    dcterms:identifier "datas_eleitorais_2026"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23760_2026> ;
    syn:confianca "4"^^xsd:integer ;
    syn:conteudo "O Calendario Eleitoral das Eleições 2026 fixa o primeiro turno em 4 de outubro e o segundo turno em 25 de outubro. A propaganda eleitoral inicia-se em 16 de agosto de 2026."^^xsd:string ;
    syn:dataOcorrencia "2026-03-02"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
    syn:formaRegistro <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material> ;
    syn:funcaoItem <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual> ;
