    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "O art. 22 permite investigar uso indevido, desvio ou abuso do poder economico ou de autoridade, ou utilizacao indevida de veiculos ou meios de comunicacao social, em beneficio de candidato ou de partido politico."@pt-BR ;
