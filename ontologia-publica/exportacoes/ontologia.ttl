<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/notoriamente_contextualizado>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "O contexto foi confirmado por fonte primaria ou verificacao especializada independente."@pt-BR ;
    rdfs:label "Notoriamente Contextualizado"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_contextual> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_contextual> ;
