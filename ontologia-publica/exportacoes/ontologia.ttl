<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/difamacao_eleitoral>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Imputacao ou divulgacao de fato ofensivo a reputacao de pessoa no contexto eleitoral, independentemente de o fato ser verdadeiro."@pt-BR ;
    rdfs:label "Difamação Eleitoral"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral> ;
    skos:definition "Imputacao ou divulgacao de fato ofensivo a reputacao de pessoa no contexto eleitoral, independentemente de o fato ser verdadeiro."@pt-BR ;
    skos:inScheme <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology> ;
    skos:notation "difamacao_eleitoral"^^xsd:string ;
    skos:prefLabel "Difamação Eleitoral"@pt-BR ;
    syn:criterioExclusao "Critica de desempenho publico, informacao de interesse publico tratada sem humilhacao ou imputacao falsa de crime."^^xsd:string ;
    syn:criterioInclusao "Ha publicizacao de fato ofensivo com finalidade ou efeito de degradar reputacao eleitoral."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Imputacao ou divulgacao de fato ofensivo a reputacao de pessoa no contexto eleitoral, independentemente de o fato ser verdadeiro."^^xsd:string ;
    syn:graph_rag_classification_guidance "Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão."@pt-BR ;
    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "subcategoria"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral> ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria> ;
    syn:rotuloPreferido "Difamação Eleitoral"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Conteudo que ataca deliberadamente honra, reputacao, dignidade ou direitos de pessoas ou grupos no contexto eleitoral."@pt-BR ;
    rdfs:label "Discurso de Ódio Eleitoral"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral> ;
    skos:definition "Conteudo que ataca deliberadamente honra, reputacao, dignidade ou direitos de pessoas ou grupos no contexto eleitoral."@pt-BR ;
    skos:inScheme <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology> ;
    skos:notation "discurso_de_odio_eleitoral"^^xsd:string ;
    skos:prefLabel "Discurso de Ódio Eleitoral"@pt-BR ;
    syn:criterioExclusao "Critica de politica publica, competencia, ato documentado, satira marcada ou discordancia ideologica sem ataque a dignidade."^^xsd:string ;
    syn:criterioInclusao "Ha ataque pessoal ou coletivo relacionado a disputa eleitoral, com dano reputacional, humilhacao ou incitacao discriminatoria."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Conteudo que ataca deliberadamente honra, reputacao, dignidade ou direitos de pessoas ou grupos no contexto eleitoral."^^xsd:string ;
    syn:graph_rag_classification_guidance "Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão."@pt-BR ;
    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "supercategoria"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral> ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/supercategoria> ;
    syn:perguntaOperacional "O conteudo ataca deliberadamente a honra, a reputacao ou a dignidade de pessoa ou grupo no contexto eleitoral?"^^xsd:string ;
    syn:rotuloPreferido "Discurso de Ódio Eleitoral"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Conteudo que fragiliza ou desacredita instituicoes democraticas, nega legitimidade eleitoral ou incita ruptura da ordem democratica."@pt-BR ;
    rdfs:label "Discursos Antidemocráticos"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral> ;
    skos:definition "Conteudo que fragiliza ou desacredita instituicoes democraticas, nega legitimidade eleitoral ou incita ruptura da ordem democratica."@pt-BR ;
    skos:inScheme <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology> ;
    skos:notation "discursos_antidemocraticos"^^xsd:string ;
    skos:prefLabel "Discursos Antidemocráticos"@pt-BR ;
    syn:criterioExclusao "Critica institucional fundamentada, proposta de reforma democratica, educacao civica, investigacao legitima ou satira identificada."^^xsd:string ;
    syn:criterioInclusao "Ha funcao de erosao de confianca institucional, negacao de legitimidade ou incitacao a acao antidemocratica."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Conteudo que fragiliza ou desacredita instituicoes democraticas, nega legitimidade eleitoral ou incita ruptura da ordem democratica."^^xsd:string ;
    syn:graph_rag_classification_guidance "Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão."@pt-BR ;
    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "supercategoria"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral> ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/supercategoria> ;
    syn:perguntaOperacional "O conteudo enfraquece a confianca democratica, nega legitimidade eleitoral ou incita ruptura institucional?"^^xsd:string ;
    syn:rotuloPreferido "Discursos Antidemocráticos"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

