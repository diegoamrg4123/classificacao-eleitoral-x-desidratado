    syn:graph_rag_evidence_review_status "pendente"^^xsd:string ;
    syn:graph_rag_evidence_reviewed "false"^^xsd:boolean ;
    syn:graph_rag_evidence_role "evidencia_conceitual"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026> ;
    syn:identificadorOcorrencia "portaria_463_prazos"^^xsd:string ;
    syn:justificativa "Os prazos da portaria estabelecem um ciclo de conformidade: entrega (16/ago), atualizacao (48h), risco extraordinario (3 dias) e relatorio final (19/dez). Sustenta o criterio de temporalidade como componente de avaliacao de ilicitude: o descumprimento dos prazos ou a ausencia de plano configuram circunstancia agravante na avaliacao normativa."^^xsd:string ;
    syn:localizacaoNaFonte "Art. 24"^^xsd:string ;
