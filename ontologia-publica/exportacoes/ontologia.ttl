<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/extremismo_antidemocratico>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Conteudo que rejeita regras e instituicoes democraticas e promove ruptura sistemica, golpe, intervencao ou violencia politica."@pt-BR ;
    rdfs:label "Extremismo Antidemocrático"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos> ;
