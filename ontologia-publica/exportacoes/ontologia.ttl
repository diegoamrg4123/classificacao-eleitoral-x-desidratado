<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/contexto_ausente>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Conteudo autentico divulgado sem informacoes necessarias de data, local, circunstancia ou finalidade, produzindo interpretacao enganosa."@pt-BR ;
    rdfs:label "Contexto Ausente"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao> ;
    skos:definition "Conteudo autentico divulgado sem informacoes necessarias de data, local, circunstancia ou finalidade, produzindo interpretacao enganosa."@pt-BR ;
    skos:inScheme <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology> ;
    skos:notation "contexto_ausente"^^xsd:string ;
    skos:prefLabel "Contexto Ausente"@pt-BR ;
    syn:criterioExclusao "O contexto omitido e irrelevante para a interpretacao ou esta disponivel de modo claro."^^xsd:string ;
    syn:criterioInclusao "A ausencia de contexto indispensavel leva a conclusao materialmente diferente da leitura contextualizada."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Conteudo autentico divulgado sem informacoes necessarias de data, local, circunstancia ou finalidade, produzindo interpretacao enganosa."^^xsd:string ;
    syn:graph_rag_classification_guidance "Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão."@pt-BR ;
    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "categoria"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/integridade_da_informacao> ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/categoria> ;
    syn:rotuloPreferido "Contexto Ausente"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/critica_legitima_ou_neutra>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Questionamento, analise ou proposta sobre instituicoes e processos eleitorais que permanece dentro do debate democratico e nao promove desinformacao nem ruptura."@pt-BR ;
    rdfs:label "Crítica Legítima ou Neutra"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral> ;
    skos:definition "Questionamento, analise ou proposta sobre instituicoes e processos eleitorais que permanece dentro do debate democratico e nao promove desinformacao nem ruptura."@pt-BR ;
    skos:inScheme <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology> ;
    skos:notation "critica_legitima_ou_neutra"^^xsd:string ;
    skos:prefLabel "Crítica Legítima ou Neutra"@pt-BR ;
    syn:criterioExclusao "Alegacao infundada de fraude, rejeicao da ordem democratica ou incitacao a ruptura."^^xsd:string ;
    syn:criterioInclusao "Ha critica fundamentada, pergunta aberta, proposta de reforma legal ou educacao civica sem negacao de legitimidade."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Questionamento, analise ou proposta sobre instituicoes e processos eleitorais que permanece dentro do debate democratico e nao promove desinformacao nem ruptura."^^xsd:string ;
    syn:graph_rag_classification_guidance "Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão."@pt-BR ;
    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "categoria"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/dominio_eleitoral> ;
    syn:notas "Conceito de fronteira do domínio, não subclasse de Discursos Antidemocráticos. ITEMs associados devem usar status excluido ou limite."^^xsd:string ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/categoria> ;
    syn:rotuloPreferido "Crítica Legítima ou Neutra"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/fronteira_exclusao> .

