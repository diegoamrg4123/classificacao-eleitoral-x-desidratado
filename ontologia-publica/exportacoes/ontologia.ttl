<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/remocao_perfis_res_23755>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "Art. 38-A. A remocao de perfil sera feita quando se tratar de usuario com perfil falso, automatizado ou robo, e a exclusao pelos provedores de aplicacao e permitida apenas nessas hipoteses."@pt-BR ;
