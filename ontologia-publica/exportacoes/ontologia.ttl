<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/limite_enfrentamento_desinformacao>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "Art. 2. As medidas para o enfrentamento da desinformacao que atente contra a integridade do processo eleitoral serao realizadas nos termos da legislacao de regencia e de resolucao deste Tribunal Superior."@pt-BR ;
