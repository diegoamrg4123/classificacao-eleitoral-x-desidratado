<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/portaria_463_escopo_provedores>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "O plano de conformidade devera ser apresentado por provedores de aplicacao que disponibilizem servicos de aplicacao de internet que desempenhem funcao relevante na producao, difusao, organizacao, recomendacao, moderacao ou impulsionamento de conteudo politico-eleitoral, incluindo, expressamente, provedores com funcionalidade de geracao de conteudo sintetico por inteligencia artificial generativa, em regra com mais de cinco milhoes de usuarios ativos mensais no Brasil."@pt-BR ;
    dcterms:identifier "portaria_463_escopo_provedores"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026> ;
    syn:confianca "4"^^xsd:integer ;
    syn:conteudo "O plano de conformidade devera ser apresentado por provedores de aplicacao que disponibilizem servicos de aplicacao de internet que desempenhem funcao relevante na producao, difusao, organizacao, recomendacao, moderacao ou impulsionamento de conteudo politico-eleitoral, incluindo, expressamente, provedores com funcionalidade de geracao de conteudo sintetico por inteligencia artificial generativa, em regra com mais de cinco milhoes de usuarios ativos mensais no Brasil."^^xsd:string ;
    syn:dataOcorrencia "2026-07-27"^^xsd:date ;
