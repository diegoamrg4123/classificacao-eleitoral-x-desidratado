<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/portaria_463_prazos>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "O plano de conformidade deve ser apresentado ate o dia 16 de agosto de 2026. Deve ser atualizado em ate 48 horas diante de alteracao substancial de risco e o provedor deve comunicar risco extraordinario a integridade do processo em ate 3 dias. O relatorio consolidado de implementacao deve ser entregue ate 19 de dezembro de 2026."@pt-BR ;
    dcterms:identifier "portaria_463_prazos"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026> ;
    syn:confianca "4"^^xsd:integer ;
    syn:conteudo "O plano de conformidade deve ser apresentado ate o dia 16 de agosto de 2026. Deve ser atualizado em ate 48 horas diante de alteracao substancial de risco e o provedor deve comunicar risco extraordinario a integridade do processo em ate 3 dias. O relatorio consolidado de implementacao deve ser entregue ate 19 de dezembro de 2026."^^xsd:string ;
    syn:dataOcorrencia "2026-07-27"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
