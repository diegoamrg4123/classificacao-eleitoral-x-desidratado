    skos:notation "sugestivamente_licito"^^xsd:string ;
    skos:prefLabel "Sugestivamente Lícito"@pt-BR ;
    syn:criterioExclusao "Licitude incontroversa ou indicios relevantes de ilicitude."^^xsd:string ;
    syn:criterioInclusao "Predominam liberdade de expressao e ausencia de elemento tipico, com pequena margem de duvida."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Conteudo provavelmente licito, embora contenha elementos que ainda geram duvida interpretativa."^^xsd:string ;
    syn:graph_rag_classification_guidance "Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão."@pt-BR ;
    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "valor_escala"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital> ;
    syn:ordemEscala "4"^^xsd:integer ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala> ;
    syn:rotuloPreferido "Sugestivamente Lícito"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/sugestivamente_veridico>
