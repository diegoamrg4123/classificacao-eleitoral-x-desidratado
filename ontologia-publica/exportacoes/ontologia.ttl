<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/janela_silencio_digital_res_23755>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "Art. 9-B, paragrafo 3-A. Ficam vedadas a publicacao e a republicacao, ainda que gratuitas, bem como o impulsionamento pago de novos conteudos sinteticos produzidos ou alterados por inteligencia artificial ou por tecnologias equivalentes que utilizem imagem, voz ou manifestacao de candidata ou candidato ou de pessoa publica, mesmo que rotulados e em conformidade com as demais exigencias deste artigo, no periodo compreendido entre as 72 horas que antecedem e as 24 horas que sucedem o termino do pleito."@pt-BR ;
    dcterms:identifier "janela_silencio_digital_res_23755"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026> ;
    syn:confianca "5"^^xsd:integer ;
    syn:conteudo "Art. 9-B, paragrafo 3-A. Ficam vedadas a publicacao e a republicacao, ainda que gratuitas, bem como o impulsionamento pago de novos conteudos sinteticos produzidos ou alterados por inteligencia artificial ou por tecnologias equivalentes que utilizem imagem, voz ou manifestacao de candidata ou candidato ou de pessoa publica, mesmo que rotulados e em conformidade com as demais exigencias deste artigo, no periodo compreendido entre as 72 horas que antecedem e as 24 horas que sucedem o termino do pleito."^^xsd:string ;
    syn:dataOcorrencia "2026-03-02"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
    syn:formaRegistro <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal> ;
    syn:funcaoItem <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual> ;
    syn:graph_rag_citation_guidance "Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão."@pt-BR ;
    syn:graph_rag_citation_source_id "resolucao_tse_23755_2026"^^xsd:string ;
    syn:graph_rag_evidence_review_status "pendente"^^xsd:string ;
    syn:graph_rag_evidence_reviewed "false"^^xsd:boolean ;
    syn:graph_rag_evidence_role "evidencia_conceitual"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico> ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026> ;
    syn:identificadorOcorrencia "janela_silencio_digital_res_23755"^^xsd:string ;
    syn:justificativa "O dispositivo cria uma janela de silencio digital que proibe novos conteudos sinteticos com imagem, voz ou manifestacao de candidaturas e pessoas publicas nas 72h antes e 24h apos o pleito, mesmo rotulados. Sustenta o criterio temporal como componente de avaliacao de ilicitude para conteudo sintetico em periodo critico."^^xsd:string ;
    syn:localizacaoNaFonte "Art. 9-B, paragrafo 3-A"^^xsd:string ;
    syn:statusEnquadramento <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido> ;
