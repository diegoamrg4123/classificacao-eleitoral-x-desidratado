<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/portaria_463_obrigacoes_ia_generativa>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "Para sistemas de inteligencia artificial generativa, chatbots e assistentes automatizados, o plano de conformidade deve apontar salvaguardas tecnicas que impecam os sistemas de opinar, comentar ou gerar conteudos que favorecam candidaturas ou contenham recomendacao de voto. O plano deve incluir mecanismos contra tentativas de contorno, rotulagem em publicacoes organicas e testes periodicos de resistencia."@pt-BR ;
    dcterms:identifier "portaria_463_obrigacoes_ia_generativa"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/portaria_tse_463_2026> ;
    syn:confianca "4"^^xsd:integer ;
    syn:conteudo "Para sistemas de inteligencia artificial generativa, chatbots e assistentes automatizados, o plano de conformidade deve apontar salvaguardas tecnicas que impecam os sistemas de opinar, comentar ou gerar conteudos que favorecam candidaturas ou contenham recomendacao de voto. O plano deve incluir mecanismos contra tentativas de contorno, rotulagem em publicacoes organicas e testes periodicos de resistencia."^^xsd:string ;
    syn:dataOcorrencia "2026-07-27"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
