<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_constitucional_democracia_e_soberania>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "Art. 1. A Republica Federativa do Brasil constitui-se em Estado Democratico de Direito. Paragrafo unico. Todo o poder emana do povo, que o exerce por meio de representantes eleitos ou diretamente, nos termos desta Constituicao."@pt-BR ;
    dcterms:identifier "base_constitucional_democracia_e_soberania"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/constituicao_federal_1988> ;
    syn:confianca "5"^^xsd:integer ;
    syn:conteudo "Art. 1. A Republica Federativa do Brasil constitui-se em Estado Democratico de Direito. Paragrafo unico. Todo o poder emana do povo, que o exerce por meio de representantes eleitos ou diretamente, nos termos desta Constituicao."^^xsd:string ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
    syn:formaRegistro <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material> ;
    syn:funcaoItem <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual> ;
    syn:graph_rag_citation_guidance "Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão."@pt-BR ;
    syn:graph_rag_citation_source_id "constituicao_federal_1988"^^xsd:string ;
    syn:graph_rag_evidence_review_status "pendente"^^xsd:string ;
    syn:graph_rag_evidence_reviewed "false"^^xsd:boolean ;
    syn:graph_rag_evidence_role "evidencia_conceitual"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/constituicao_federal_1988> ;
    syn:identificadorOcorrencia "base_constitucional_democracia_e_soberania"^^xsd:string ;
    syn:justificativa "Os fundamentos constitucionais de Estado Democratico de Direito e soberania popular sustentam a supercategoria como registro de conteudos que procuram erodir a legitimidade das instituicoes ou do processo eleitoral."^^xsd:string ;
