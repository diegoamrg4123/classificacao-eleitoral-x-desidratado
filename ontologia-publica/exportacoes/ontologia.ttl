    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "valor_escala"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao> ;
    syn:ordemEscala "1"^^xsd:integer ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/valor_escala> ;
    syn:rotuloPreferido "Notoriamente Verídico"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/odio_direcionado_a_grupos>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Ataque a grupo protegido por caracteristica identitaria, demografica ou pertencimento politico reconhecido, no contexto eleitoral."@pt-BR ;
    rdfs:label "Discurso de Ódio Direcionado a Grupos"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral> ;
    skos:definition "Ataque a grupo protegido por caracteristica identitaria, demografica ou pertencimento politico reconhecido, no contexto eleitoral."@pt-BR ;
    skos:inScheme <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology> ;
    skos:notation "odio_direcionado_a_grupos"^^xsd:string ;
    skos:prefLabel "Discurso de Ódio Direcionado a Grupos"@pt-BR ;
    syn:alvoTipico "Grupos raciais, religiosos, de genero, sexualidade, origem ou pertencimento politico."^^xsd:string ;
    syn:criterioExclusao "Mencao factual, critica de politica ou denuncia de discriminacao sem ataque ao grupo. Tambem fica de fora o ataque a grupos definidos apenas por ocupacao, atividade, profissao, torcida, time ou preferencia (ex.: youtubers, streamers, influencers, jogadores, programadores), ainda que a critica seja politica: esses casos usam injuria_eleitoral quando ha pessoa identificavel, ou nenhum conceito quando ha apenas posicao ou opiniao."^^xsd:string ;
    syn:criterioInclusao "Ha generalizacao ofensiva, desumanizacao, discriminacao ou incitacao contra grupo protegido por caracteristica identitaria, demografica, religiosa, de genero, sexualidade, origem ou pertencimento politico."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Ataque a grupo protegido por caracteristica identitaria, demografica ou pertencimento politico reconhecido, no contexto eleitoral."^^xsd:string ;
    syn:graph_rag_classification_guidance "Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão."@pt-BR ;
    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "subcategoria"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral> ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria> ;
    syn:rotuloPreferido "Discurso de Ódio Direcionado a Grupos"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

