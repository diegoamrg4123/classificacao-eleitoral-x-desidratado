    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026> ;
    syn:identificadorOcorrencia "remocao_perfis_res_23755"^^xsd:string ;
    syn:justificativa "O dispositivo delimita o alcance da remocao de perfis: apenas perfis falsos, automatizados ou robo, em pratica reiterada. Sustenta fronteira entre moderacao aceitavel (remocao de bot) e moderacao que exige avaliacao judicial (remocao de perfil real). Relevante para avaliar resposta de plataformas a conteudos sinteticos que circulam sem responsavel identificavel."^^xsd:string ;
