<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology>
    a owl:Ontology ;
    dcterms:description "Recorte publico para consulta por revisores. Preserva a estrutura conceitual e a relacao complementar da ontologia de origem; inclui somente proveniencia normativa e evidencias conceituais selecionadas. Nao replica o corpus, os exemplos internos ou a base experimental. Os estados de revisao permanecem inalterados."@pt-BR ;
    dcterms:language "pt-BR"^^xsd:language ;
    dcterms:title "Ontologia do Domínio Eleitoral"@pt-BR ;
    owl:versionInfo "0.1.0"^^xsd:string ;
    prov:wasDerivedFrom <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#input/fontes_registros_fontes_publicas_syn> ;
    prov:wasDerivedFrom <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#input/itens_evidencias_publicas_syn> ;
    prov:wasDerivedFrom <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#input/ontologia_dominio_eleitoral_syno> ;
    prov:wasDerivedFrom <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#input/ontologia_relacoes_ontologicas_csv> ;
    prov:wasDerivedFrom <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#input/ontologia_vocabulario_relacoes_csv> ;
    prov:wasDerivedFrom <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#input/projeto_synp> ;
    prov:wasDerivedFrom <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#input/template_synt> ;
    syn:conceptCount "49"^^xsd:integer ;
    syn:fieldCount "51"^^xsd:integer ;
    syn:hasGraphRagProfile <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#profile/classification_assistance> ;
    syn:itemCount "36"^^xsd:integer ;
    syn:namespace "https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#"^^xsd:anyURI ;
    syn:privateEntityLayerIncluded "false"^^xsd:boolean ;
    syn:projectStatus "rascunho_em_revisao"^^xsd:string ;
    syn:relationCount "1"^^xsd:integer ;
    syn:sourceCount "15"^^xsd:integer ;
    syn:tripleCount "3529"^^xsd:integer .

syn:CanonicalInput
    a owl:Class ;
    rdfs:comment "Arquivo canônico usado na derivação do entregável."@pt-BR ;
    rdfs:label "CanonicalInput"@pt-BR .

syn:EnumerationValue
    a owl:Class ;
    rdfs:comment "Valor permitido por campo enumerado do Synesis."@pt-BR ;
    rdfs:label "EnumerationValue"@pt-BR .

syn:FieldDefinition
    a owl:Class ;
    rdfs:comment "Definição de campo do template Synesis."@pt-BR ;
    rdfs:label "FieldDefinition"@pt-BR .

syn:GraphRagProfile
    a owl:Class ;
    rdfs:comment "Políticas derivadas para recuperação aumentada por grafo com revisão humana."@pt-BR ;
    rdfs:label "GraphRagProfile"@pt-BR .

syn:Item
    a owl:Class ;
    rdfs:comment "Unidade de evidência ou exemplo Synesis."@pt-BR ;
    rdfs:label "Item"@pt-BR .

syn:OntologyConcept
    a owl:Class ;
    rdfs:comment "Conceito formal da ontologia Synesis."@pt-BR ;
    rdfs:label "OntologyConcept"@pt-BR .

syn:OntologyRelation
    a owl:Class ;
    rdfs:comment "Relação complementar declarada em CSV."@pt-BR ;
    rdfs:label "OntologyRelation"@pt-BR .

syn:Source
    a owl:Class ;
    rdfs:comment "Registro de proveniência Synesis."@pt-BR ;
    rdfs:label "Source"@pt-BR .

syn:SynesisProject
    a owl:Class ;
    rdfs:comment "Manifesto Synesis do projeto."@pt-BR ;
    rdfs:label "SynesisProject"@pt-BR .

syn:SynesisTemplate
    a owl:Class ;
    rdfs:comment "Contrato de campos Synesis."@pt-BR ;
    rdfs:label "SynesisTemplate"@pt-BR .

syn:alvoTipico
    a owl:DatatypeProperty ;
    rdfs:comment "Pessoa, grupo, instituicao, processo ou objeto normalmente atingido."@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:range xsd:string .

syn:caminhoArquivo
    a owl:DatatypeProperty ;
    rdfs:comment "Caminho relativo ao arquivo incorporado no subprojeto."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

syn:checksumSha256
    a owl:DatatypeProperty ;
    rdfs:comment "Hash SHA-256 do arquivo incorporado."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

syn:cicloEleitoral
    a owl:DatatypeProperty ;
    rdfs:comment "Ciclo eleitoral ao qual a fonte se refere."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/acusacao_de_fraude_institucional>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Conteudo que alega, sem evidencia concreta verificavel, fraude ou manipulacao sistematica por instituicoes responsaveis pelo processo eleitoral."@pt-BR ;
    rdfs:label "Acusação de Fraude Institucional"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos> ;
    skos:definition "Conteudo que alega, sem evidencia concreta verificavel, fraude ou manipulacao sistematica por instituicoes responsaveis pelo processo eleitoral."@pt-BR ;
    skos:inScheme <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology> ;
    skos:notation "acusacao_de_fraude_institucional"^^xsd:string ;
    skos:prefLabel "Acusação de Fraude Institucional"@pt-BR ;
    syn:criterioExclusao "Denuncia com evidencia substancial, investigacao aberta por instituicao competente ou pergunta que reconhece incerteza."^^xsd:string ;
    syn:criterioInclusao "Ha acusacao de fraude institucional sem evidencia crivel, baseada em fonte nao verificavel ou alegacao ja refutada."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Conteudo que alega, sem evidencia concreta verificavel, fraude ou manipulacao sistematica por instituicoes responsaveis pelo processo eleitoral."^^xsd:string ;
    syn:graph_rag_classification_guidance "Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão."@pt-BR ;
    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "subcategoria"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos> ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria> ;
    syn:rotuloPreferido "Acusação de Fraude Institucional"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Conteudo que dissemina alegacoes tecnicas infundadas sobre inseguranca, fraude ou manipulacao das urnas eletronicas e ignora mecanismos de auditoria."@pt-BR ;
    rdfs:label "Ataque às Urnas Eletrônicas"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discursos_antidemocraticos> ;
