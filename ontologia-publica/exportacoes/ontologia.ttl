    rdfs:comment "Unidade de analise cujo tema, uso ou contexto relevante envolve eleicoes, atores eleitorais, instituicoes democraticas ou processos de votacao."@pt-BR ;
    rdfs:label "Conteúdo de tema eleitoral"@pt-BR ;
    skos:definition "Unidade de analise cujo tema, uso ou contexto relevante envolve eleicoes, atores eleitorais, instituicoes democraticas ou processos de votacao."@pt-BR ;
