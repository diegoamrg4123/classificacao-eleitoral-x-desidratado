    skos:prefLabel "Vídeo Sintético"@pt-BR ;
    syn:criterioExclusao "Video real apenas recortado, acelerado ou editado sem sintese gerativa central."^^xsd:string ;
    syn:criterioInclusao "A sequencia audiovisual foi sintetizada integralmente ou substitui identidade e fala de forma gerativa."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Video ou deepfake gerado por IA que representa fala, identidade ou situacao sem registro audiovisual autentico correspondente."^^xsd:string ;
    syn:graph_rag_classification_guidance "Candidato operacional: só selecione quando a definição e o critério de inclusão forem compatíveis com características observáveis do conteúdo; confira também o critério de exclusão."@pt-BR ;
    syn:graph_rag_classification_role "operational_candidate"^^xsd:string ;
    syn:graph_rag_hierarchy_role "subcategoria"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico> ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria> ;
    syn:rotuloPreferido "Vídeo Sintético"^^xsd:string ;
    syn:sinonimos "deepfake de video"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

syn:confianca
    a owl:DatatypeProperty ;
    rdfs:comment "Confianca no vinculo entre o ITEM e os conceitos, de 1 muito baixa a 5 muito alta."@pt-BR ;
    rdfs:domain syn:Item ;
    rdfs:range xsd:integer .

syn:conteudo
    a owl:DatatypeProperty ;
    rdfs:comment "Fragmento, exemplo, transcricao ou descricao textual selecionada."@pt-BR ;
    rdfs:domain syn:Item ;
    rdfs:range xsd:string .

syn:contexto
    a owl:DatatypeProperty ;
    rdfs:comment "Contexto necessario para interpretar o conteudo."@pt-BR ;
    rdfs:domain syn:Item ;
    rdfs:range xsd:string .

syn:criterioExclusao
    a owl:DatatypeProperty ;
    rdfs:comment "Casos proximos que devem permanecer fora do conceito."@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:range xsd:string .

syn:criterioInclusao
    a owl:DatatypeProperty ;
    rdfs:comment "Evidencia minima para aplicar ou reconhecer o conceito."@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:range xsd:string .

syn:dataAcesso
    a owl:DatatypeProperty ;
    rdfs:comment "Data de acesso no formato AAAA-MM-DD."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:date .

syn:dataIncorporacao
    a owl:DatatypeProperty ;
    rdfs:comment "Data de incorporacao ao subprojeto no formato AAAA-MM-DD."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:date .

syn:dataOcorrencia
    a owl:DatatypeProperty ;
    rdfs:comment "Data da ocorrencia no formato AAAA-MM-DD."@pt-BR ;
    rdfs:domain syn:Item ;
    rdfs:range xsd:date .

syn:definicaoOperacional
    a owl:DatatypeProperty ;
    rdfs:comment "Definicao que permite reconhecer o conceito e distingui-lo dos vizinhos."@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:range xsd:string .

syn:descricaoFonte
    a owl:DatatypeProperty ;
    rdfs:comment "Descricao breve do que a fonte representa no projeto."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

