    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/dimensao> ;
    syn:perguntaOperacional "Qual e o grau de confirmacao juridica ou tecnica da ilicitude?"^^xsd:string ;
    syn:rotuloPreferido "Ilicitude no Ambiente Digital"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/estrutural> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/imagem_sintetica>
