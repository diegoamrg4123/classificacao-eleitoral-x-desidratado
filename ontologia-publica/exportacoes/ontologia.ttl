    skos:prefLabel "Ataque às Urnas Eletrônicas"@pt-BR ;
    syn:criterioExclusao "Analise tecnica documentada, proposta de melhoria, pergunta aberta ou educacao sobre auditoria."^^xsd:string ;
    syn:criterioInclusao "Ha afirmacao conclusiva de vulnerabilidade ou fraude das urnas sem respaldo tecnico verificavel."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Conteudo que dissemina alegacoes tecnicas infundadas sobre inseguranca, fraude ou manipulacao das urnas eletronicas e ignora mecanismos de auditoria."^^xsd:string ;
