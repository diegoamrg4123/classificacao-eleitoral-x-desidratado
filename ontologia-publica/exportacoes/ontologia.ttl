<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/notoriamente_veridico>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Fato comprovado por consenso entre fontes confiaveis, sem controversia razoavel."@pt-BR ;
    rdfs:label "Notoriamente Verídico"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao> ;
