    skos:prefLabel "Sugestivamente Verídico"@pt-BR ;
    syn:criterioExclusao "Consenso incontroverso, evidencia equilibrada ou preponderancia contraria."^^xsd:string ;
    syn:criterioInclusao "A maioria das fontes confiaveis apoia a afirmacao sem consenso absoluto."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Preponderancia de evidencia apoia a afirmacao, mas permanece margem legitima para revisao."^^xsd:string ;
