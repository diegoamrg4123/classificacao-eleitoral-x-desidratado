    syn:graph_rag_hierarchy_role "subcategoria"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "false"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_manipulado> ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/subcategoria> ;
    syn:rotuloPreferido "Transformado"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/classificatorio> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Dimensao transversal que descreve o estado factual das afirmacoes verificaveis, independentemente da intencao de quem as produziu."@pt-BR ;
    rdfs:label "Veracidade da Informação"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao> ;
    skos:definition "Dimensao transversal que descreve o estado factual das afirmacoes verificaveis, independentemente da intencao de quem as produziu."@pt-BR ;
    skos:inScheme <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology> ;
    skos:notation "veracidade_da_informacao"^^xsd:string ;
    skos:prefLabel "Veracidade da Informação"@pt-BR ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Dimensao transversal que descreve o estado factual das afirmacoes verificaveis, independentemente da intencao de quem as produziu."^^xsd:string ;
    syn:graph_rag_classification_guidance "Contexto estrutural: use para explicar a posição hierárquica, mas não o retorne como categoria operacional."@pt-BR ;
    syn:graph_rag_classification_role "structural_context"^^xsd:string ;
    syn:graph_rag_hierarchy_role "dimensao"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_structural_context_only "true"^^xsd:boolean ;
    syn:hasParentConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/desinformacao> ;
    syn:papelHierarquico <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/papel_hierarquico/dimensao> ;
    syn:perguntaOperacional "As afirmacoes factuais centrais sao verdadeiras diante das evidencias disponiveis?"^^xsd:string ;
    syn:rotuloPreferido "Veracidade da Informação"^^xsd:string ;
    syn:tipoConceito <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_conceito/estrutural> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/video_sintetico>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
