<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/sugestivamente_licito>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Conteudo provavelmente licito, embora contenha elementos que ainda geram duvida interpretativa."@pt-BR ;
    rdfs:label "Sugestivamente Lícito"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital> ;
    skos:broader <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital> ;
    skos:definition "Conteudo provavelmente licito, embora contenha elementos que ainda geram duvida interpretativa."@pt-BR ;
