<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/teste_biometria_res_23758>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "A Resolucao 23.758/2026 acrescenta o Teste de Integridade com Biometria ao rol de auditorias do sistema eletronico de votacao. O teste e realizado em locais de votacao, com eleitoras e eleitores voluntarios que consentem com a utilizacao de suas biometrias para a habilitacao da urna eletronica."@pt-BR ;
    dcterms:identifier "teste_biometria_res_23758"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23758_2026> ;
    syn:confianca "4"^^xsd:integer ;
    syn:conteudo "A Resolucao 23.758/2026 acrescenta o Teste de Integridade com Biometria ao rol de auditorias do sistema eletronico de votacao. O teste e realizado em locais de votacao, com eleitoras e eleitores voluntarios que consentem com a utilizacao de suas biometrias para a habilitacao da urna eletronica."^^xsd:string ;
    syn:dataOcorrencia "2026-03-02"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
    syn:formaRegistro <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material> ;
    syn:funcaoItem <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual> ;
    syn:graph_rag_citation_guidance "Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão."@pt-BR ;
    syn:graph_rag_citation_source_id "resolucao_tse_23758_2026"^^xsd:string ;
    syn:graph_rag_evidence_review_status "pendente"^^xsd:string ;
    syn:graph_rag_evidence_reviewed "false"^^xsd:boolean ;
    syn:graph_rag_evidence_role "evidencia_conceitual"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23758_2026> ;
    syn:identificadorOcorrencia "teste_biometria_res_23758"^^xsd:string ;
    syn:justificativa "A inclusao de um teste publico de integridade com biometria de eleitores reforca o argumento de que o sistema eletronico de votacao dispoe de mecanismos de verificacao em evolucao. Sustenta a fronteira entre critica tecnica documentada e alegacao conclusiva de fraude, pois o objeto criticado continua contando com auditorias institucionais amplas e, agora, com participacao direta do eleitor."^^xsd:string ;
    syn:localizacaoNaFonte "Arts. 2, XVI-A, XVI-B, 53-A"^^xsd:string ;
    syn:statusEnquadramento <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido> ;
    syn:statusRevisao <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente> ;
    syn:tipoMidia <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/vedacao_ia_ator_eleitoral_res_23755>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "Art. 28, paragrafo 1-C. E vedado aos provedores de aplicacao que ofertem sistemas de inteligencia artificial ou por tecnologia equivalente: I - ranquear, recomendar, sugerir ou priorizar candidatas/os, campanhas, partidos politicos, federacoes ou coligacoes; II - emitir opinioes, indicar preferencia eleitoral, recomendar voto ou realizar qualquer forma de favorecimento ou desfavorecimento politico-eleitoral, inclusive por meio de respostas automatizadas."@pt-BR ;
    dcterms:identifier "vedacao_ia_ator_eleitoral_res_23755"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026> ;
    syn:confianca "5"^^xsd:integer ;
    syn:conteudo "Art. 28, paragrafo 1-C. E vedado aos provedores de aplicacao que ofertem sistemas de inteligencia artificial ou por tecnologia equivalente: I - ranquear, recomendar, sugerir ou priorizar candidatas/os, campanhas, partidos politicos, federacoes ou coligacoes; II - emitir opinioes, indicar preferencia eleitoral, recomendar voto ou realizar qualquer forma de favorecimento ou desfavorecimento politico-eleitoral, inclusive por meio de respostas automatizadas."^^xsd:string ;
    syn:dataOcorrencia "2026-03-02"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
    syn:formaRegistro <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal> ;
    syn:funcaoItem <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual> ;
    syn:graph_rag_citation_guidance "Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão."@pt-BR ;
    syn:graph_rag_citation_source_id "resolucao_tse_23755_2026"^^xsd:string ;
    syn:graph_rag_evidence_review_status "pendente"^^xsd:string ;
    syn:graph_rag_evidence_reviewed "false"^^xsd:boolean ;
    syn:graph_rag_evidence_role "evidencia_conceitual"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico> ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026> ;
    syn:identificadorOcorrencia "vedacao_ia_ator_eleitoral_res_23755"^^xsd:string ;
    syn:justificativa "O dispositivo define fronteira: ferramenta de IA generativa nao pode atuar como ator eleitoral. A vedacao de recomendar, ranquear ou emitir preferencia por respostas automatizadas distingue ferramenta neutra de ferramenta que interfere no processo. Sustenta criterio de inclusao para avaliacao de ilicitude em uso de IA por provedores."^^xsd:string ;
    syn:localizacaoNaFonte "Art. 28, paragrafo 1-C, I e II"^^xsd:string ;
    syn:statusEnquadramento <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido> ;
    syn:statusRevisao <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente> ;
    syn:tipoMidia <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto> .

syn:justificativa
    a owl:DatatypeProperty ;
    rdfs:comment "Explicacao do vinculo entre o conteudo, sua funcao e os conceitos aplicados."@pt-BR ;
    rdfs:domain syn:Item ;
    rdfs:range xsd:string .

syn:licenca
    a owl:DatatypeProperty ;
    rdfs:comment "Licenca ou condicao de uso conhecida."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

syn:localizacaoNaFonte
    a owl:DatatypeProperty ;
    rdfs:comment "Pagina, paragrafo, linha, intervalo ou timestamp."@pt-BR ;
    rdfs:domain syn:Item ;
    rdfs:range xsd:string .

syn:mecanismoDeDano
    a owl:DatatypeProperty ;
    rdfs:comment "Forma pela qual o conteudo produz o dano descrito."@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:range xsd:string .

syn:metodoColeta
    a owl:DatatypeProperty ;
    rdfs:comment "Metodo pelo qual a fonte ou os dados foram obtidos."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

syn:nomeOriginal
    a owl:DatatypeProperty ;
    rdfs:comment "Nome do arquivo antes da incorporacao ao subprojeto."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

syn:notas
    a owl:DatatypeProperty ;
    rdfs:comment "Observacoes curtas nao cobertas pelos demais campos."@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:range xsd:string .

syn:notasRevisao
    a owl:DatatypeProperty ;
    rdfs:comment "Divergencias, pendencias ou observacoes adicionais da revisao."@pt-BR ;
    rdfs:domain syn:Item ;
    rdfs:range xsd:string .

syn:ordemEscala
    a owl:DatatypeProperty ;
    rdfs:comment "Posicao numerica quando o conceito for valor de escala."@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:range xsd:integer .

syn:origemAnterior
    a owl:DatatypeProperty ;
    rdfs:comment "Local ou contexto anterior de onde o arquivo foi incorporado."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

syn:papelHierarquico
    a owl:ObjectProperty ;
    rdfs:comment "Posicao organizacional do conceito."@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:range syn:EnumerationValue .

syn:perguntaOperacional
    a owl:DatatypeProperty ;
    rdfs:comment "Pergunta usada para reconhecer o conceito durante a anotacao."@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:range xsd:string .

syn:periodoCoberto
    a owl:DatatypeProperty ;
    rdfs:comment "Periodo temporal abrangido pela fonte ou processo."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

syn:plataforma
    a owl:DatatypeProperty ;
    rdfs:comment "Plataforma digital associada a fonte."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#profile/classification_assistance>
    a owl:NamedIndividual ;
    a syn:GraphRagProfile ;
    syn:graph_rag_evidence_policy "Cite ITEM e SOURCE; ITEMs pendentes não são precedentes aprovados; fontes jurídicas ancoram a interpretação, mas não determinam crime, ilicitude, sanção ou veracidade."@pt-BR ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:graph_rag_profile_id "classification_assistance"^^xsd:string ;
    syn:graph_rag_project_status "rascunho_em_revisao"^^xsd:string ;
    syn:graph_rag_purpose "Contexto recuperável para classificação assistida e revisão humana."@pt-BR ;
    syn:graph_rag_selection_policy "Priorize conceitos com tipo_conceito classificatorio como candidatos; use conceitos estruturais como contexto hierárquico, não como rótulos operacionais."@pt-BR .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#project/ontologia_dominio_eleitoral_publica>
    a owl:NamedIndividual ;
    a syn:SynesisProject ;
    dcterms:description "Recorte publico para consulta por revisores. Preserva a estrutura conceitual e a relacao complementar da ontologia de origem; inclui somente proveniencia normativa e evidencias conceituais selecionadas. Nao replica o corpus, os exemplos internos ou a base experimental. Os estados de revisao permanecem inalterados."@pt-BR ;
    dcterms:identifier "ontologia_dominio_eleitoral_publica"^^xsd:string ;
    dcterms:language "pt-BR"^^xsd:language ;
    syn:exportsOntology <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology> ;
    syn:projectStatus "rascunho_em_revisao"^^xsd:string ;
    syn:usesTemplate <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#template/ontologia_dominio_eleitoral> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#relation/rel_calunia_requer_veracidade>
    a owl:NamedIndividual ;
    a syn:OntologyRelation ;
    syn:isEvidencedBy <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_ce_calunia> ;
    syn:isEvidencedBy <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/base_legal_cp_calunia> ;
    syn:justification "A aplicacao de calunia eleitoral requer avaliar a falsidade da imputacao de crime sem deduzir valor especifico da escala de veracidade"@pt-BR ;
    syn:notes "Nao torna calunia subclasse de desinformacao nem conclui crime automaticamente"@pt-BR ;
    syn:relationId "rel_calunia_requer_veracidade"^^xsd:string ;
    syn:relationOrigin <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/calunia_eleitoral> ;
    syn:relationProperty syn:requerAvaliacaoDeVeracidade ;
    syn:relationTarget <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao> ;
    syn:relationTypeCode "requer_avaliacao_de_veracidade"^^xsd:string ;
    syn:reviewStatus "aprovado"^^xsd:string .

syn:requerAvaliacaoDeVeracidade
    a owl:ObjectProperty ;
    rdfs:comment "A aplicacao do conceito de origem requer avaliar a dimensao de destino sem concluir valor especifico da escala"@pt-BR ;
    rdfs:domain syn:OntologyConcept ;
    rdfs:label "Requer avaliacao de veracidade"@pt-BR ;
    rdfs:range syn:OntologyConcept ;
    syn:conditionsOfNonUse "Nao use para causalidade ou para deduzir valor da escala"@pt-BR ;
    syn:conditionsOfUse "Use quando a categoria depende de verificacao factual"@pt-BR ;
    syn:direction "origem_para_destino"^^xsd:string ;
    syn:relationTypeCode "requer_avaliacao_de_veracidade"^^xsd:string ;
    syn:reviewStatus "aprovado"^^xsd:string .

syn:restricaoCompartilhamento
    a owl:DatatypeProperty ;
    rdfs:comment "Restricoes de acesso, privacidade ou redistribuicao."@pt-BR ;
    rdfs:domain syn:Source ;
    rdfs:range xsd:string .

syn:rotuloOriginal
    a owl:DatatypeProperty ;
    rdfs:comment "Classificacao existente antes da harmonizacao com a ontologia."@pt-BR ;
    rdfs:domain syn:Item ;
    rdfs:range xsd:string .

syn:rotuloPreferido
