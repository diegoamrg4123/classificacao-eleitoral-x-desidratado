    skos:notation "notoriamente_veridico"^^xsd:string ;
    skos:prefLabel "Notoriamente Verídico"@pt-BR ;
    syn:criterioExclusao "Apenas preponderancia parcial, debate legitimo ou ausencia de verificacao conclusiva."^^xsd:string ;
    syn:criterioInclusao "Evidencia independente e convergente confirma a afirmacao."^^xsd:string ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Fato comprovado por consenso entre fontes confiaveis, sem controversia razoavel."^^xsd:string ;
