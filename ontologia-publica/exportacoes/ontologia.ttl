<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/ilicito_conteudo_sintetico_res_23757>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "Art. 6, paragrafo 4. A utilizacao da internet, inclusive servicos de mensageria, para difundir informacoes falsas ou descontextualizadas em prejuizo de adversaria(o) ou em beneficio de candidata(o), ou a respeito do sistema eletronico de votacao e da Justica Eleitoral, assim como o uso de conteudo sintetico gerado ou modificado por inteligencia artificial ou tecnologias equivalentes em violacao as normas eleitorais, configura uso indevido dos meios de comunicacao e, pelas circunstancias do caso, tambem abuso dos poderes politico e economico."@pt-BR ;
    dcterms:identifier "ilicito_conteudo_sintetico_res_23757"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23757_2026> ;
    syn:confianca "5"^^xsd:integer ;
    syn:conteudo "Art. 6, paragrafo 4. A utilizacao da internet, inclusive servicos de mensageria, para difundir informacoes falsas ou descontextualizadas em prejuizo de adversaria(o) ou em beneficio de candidata(o), ou a respeito do sistema eletronico de votacao e da Justica Eleitoral, assim como o uso de conteudo sintetico gerado ou modificado por inteligencia artificial ou tecnologias equivalentes em violacao as normas eleitorais, configura uso indevido dos meios de comunicacao e, pelas circunstancias do caso, tambem abuso dos poderes politico e economico."^^xsd:string ;
    syn:dataOcorrencia "2026-03-02"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
    syn:formaRegistro <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal> ;
    syn:funcaoItem <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual> ;
    syn:graph_rag_citation_guidance "Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão."@pt-BR ;
    syn:graph_rag_citation_source_id "resolucao_tse_23757_2026"^^xsd:string ;
    syn:graph_rag_evidence_review_status "pendente"^^xsd:string ;
    syn:graph_rag_evidence_reviewed "false"^^xsd:boolean ;
    syn:graph_rag_evidence_role "evidencia_conceitual"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/acusacao_de_fraude_institucional> ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas> ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ilicitude_no_ambiente_digital> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23757_2026> ;
    syn:identificadorOcorrencia "ilicito_conteudo_sintetico_res_23757"^^xsd:string ;
    syn:justificativa "O dispositivo e a norma que fecha o circuito regulatório: conteudo sintetico em violacao a normas eleitorais configura ilicito eleitoral. Alem disso, mantiem a tipificacao de difusao de informacoes falsas ou descontextualizadas sobre o sistema eletronico de votacao e a Justica Eleitoral. Ambas as hipoteses reforcam a avaliacao de ilicitude para conteudos que atacam o sistema ou difundem falsidades, sem transformar toda classificacao em conclusao automatica de crime."^^xsd:string ;
    syn:localizacaoNaFonte "Art. 6, paragrafo 4"^^xsd:string ;
    syn:statusEnquadramento <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido> ;
    syn:statusRevisao <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente> ;
    syn:tipoMidia <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/includefensoria_fiscalizadoras_res_23758>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "A Resolucao 23.758/2026 inclui a Defensoria Publica entre as entidades fiscalizadoras do sistema eletronico de votacao, ao lado do Ministerio Publico, partidos, federacoes, OAB, Forcas Armadas e demais orgaos previstos no art. 6."@pt-BR ;
    dcterms:identifier "includefensoria_fiscalizadoras_res_23758"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23758_2026> ;
    syn:confianca "4"^^xsd:integer ;
    syn:conteudo "A Resolucao 23.758/2026 inclui a Defensoria Publica entre as entidades fiscalizadoras do sistema eletronico de votacao, ao lado do Ministerio Publico, partidos, federacoes, OAB, Forcas Armadas e demais orgaos previstos no art. 6."^^xsd:string ;
    syn:dataOcorrencia "2026-03-02"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
    syn:formaRegistro <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material> ;
    syn:funcaoItem <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual> ;
    syn:graph_rag_citation_guidance "Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão."@pt-BR ;
    syn:graph_rag_citation_source_id "resolucao_tse_23758_2026"^^xsd:string ;
    syn:graph_rag_evidence_review_status "pendente"^^xsd:string ;
    syn:graph_rag_evidence_reviewed "false"^^xsd:boolean ;
    syn:graph_rag_evidence_role "evidencia_conceitual"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/ataque_as_urnas_eletronicas> ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/critica_legitima_ou_neutra> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23758_2026> ;
    syn:identificadorOcorrencia "includefensoria_fiscalizadoras_res_23758"^^xsd:string ;
    syn:justificativa "A ampliacao do rol de entidades fiscalizadoras inclui orgao de defesa de direitos fundamentais. Isso reforca que a fiscalizacao das urnas nao e controlada por um unico ator institucional e que criticas tecnicas feitas por orgaos legitimados constitucionalmente nao devem ser confundidas com ataques infundados ao sistema."^^xsd:string ;
    syn:localizacaoNaFonte "Art. 6, III-A"^^xsd:string ;
    syn:statusEnquadramento <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido> ;
    syn:statusRevisao <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_revisao/pendente> ;
    syn:tipoMidia <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/tipo_midia/texto> .

<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/inversao_onus_prova_res_23755>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "Art. 9-I. Nas representacoes que versem sobre o uso de conteudo sintetico gerado por inteligencia artificial ou por tecnologia equivalente que apurem violacoes aos arts. 9-B, 9-C, 9-D e 9-E desta Resolucao, o juiz podera, motivadamente, inverter o onus da prova quando, em razao da dificuldade tecnica de comprovacao da manipulacao digital, for excessivamente oneroso ao autor demonstrar a irregularidade do conteudo."@pt-BR ;
    dcterms:identifier "inversao_onus_prova_res_23755"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026> ;
    syn:confianca "4"^^xsd:integer ;
    syn:conteudo "Art. 9-I. Nas representacoes que versem sobre o uso de conteudo sintetico gerado por inteligencia artificial ou por tecnologia equivalente que apurem violacoes aos arts. 9-B, 9-C, 9-D e 9-E desta Resolucao, o juiz podera, motivadamente, inverter o onus da prova quando, em razao da dificuldade tecnica de comprovacao da manipulacao digital, for excessivamente oneroso ao autor demonstrar a irregularidade do conteudo."^^xsd:string ;
    syn:dataOcorrencia "2026-03-02"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
    syn:formaRegistro <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/adaptacao_de_material> ;
    syn:funcaoItem <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual> ;
    syn:graph_rag_citation_guidance "Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão."@pt-BR ;
    syn:graph_rag_citation_source_id "resolucao_tse_23755_2026"^^xsd:string ;
    syn:graph_rag_evidence_review_status "pendente"^^xsd:string ;
    syn:graph_rag_evidence_reviewed "false"^^xsd:boolean ;
    syn:graph_rag_evidence_role "evidencia_conceitual"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico> ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/veracidade_da_informacao> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026> ;
    syn:identificadorOcorrencia "inversao_onus_prova_res_23755"^^xsd:string ;
    syn:justificativa "A inversao motivada do onus da prova em casos de conteudo sintetico reforca que o grau de comprovacao tecnica pode variar conforme as circunstancias. Isso interage com o campo confianca do ITEM e com a dimensao de Veracidade, pois a dificuldade de demonstrar manipulacao nao decide automaticamente o valor da veracidade."^^xsd:string ;
    syn:localizacaoNaFonte "Art. 9-I"^^xsd:string ;
    syn:statusEnquadramento <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/status_enquadramento/incluido> ;
