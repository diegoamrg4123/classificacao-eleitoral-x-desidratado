<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/calunia_eleitoral>
    a owl:Class ;
    a owl:NamedIndividual ;
    a skos:Concept ;
    a syn:OntologyConcept ;
    rdfs:comment "Atribuicao falsa e verificavel de fato definido como crime a pessoa no contexto eleitoral, apresentada como verdadeira."@pt-BR ;
    rdfs:label "Calúnia Eleitoral"@pt-BR ;
    rdfs:subClassOf <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/discurso_de_odio_eleitoral> ;
