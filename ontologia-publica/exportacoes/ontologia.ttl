    skos:notation "conteudo_tema_eleitoral"^^xsd:string ;
    skos:prefLabel "Conteúdo de tema eleitoral"@pt-BR ;
    syn:declaredIn "ontologia/dominio-eleitoral.syno"^^xsd:string ;
    syn:definicaoOperacional "Unidade de analise cujo tema, uso ou contexto relevante envolve eleicoes, atores eleitorais, instituicoes democraticas ou processos de votacao."^^xsd:string ;
    syn:graph_rag_classification_guidance "Contexto estrutural: use para explicar a posição hierárquica, mas não o retorne como categoria operacional."@pt-BR ;
