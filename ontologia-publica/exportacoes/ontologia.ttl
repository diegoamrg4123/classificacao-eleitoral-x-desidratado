    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/lei_7716_1989> ;
    syn:identificadorOcorrencia "base_legal_lei_7716_injuria_racial"^^xsd:string ;
    syn:justificativa "A injuria racial e ancora juridica especializada para casos individuais de injuria eleitoral motivada por raca, cor, etnia ou procedencia nacional."^^xsd:string ;
    syn:localizacaoNaFonte "Art. 2-A"^^xsd:string ;
