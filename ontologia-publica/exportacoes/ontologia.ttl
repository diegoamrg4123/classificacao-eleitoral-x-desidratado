<https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#item/res_23755_rotulagem_conteudo_sintetico>
    a owl:NamedIndividual ;
    a syn:Item ;
    dcterms:description "Art. 9-B. A utilizacao na propaganda eleitoral, em qualquer modalidade, de conteudo sintetico multimidia gerado por meio de inteligencia artificial ou tecnologia equivalente para criar, substituir, omitir, mesclar ou alterar a velocidade ou sobrepor imagens ou sons, impoe ao responsavel pela propaganda o dever de informar, de modo explicito, destacado e acessivel, que o conteudo foi fabricado ou manipulado e qual tecnologia foi utilizada."@pt-BR ;
    dcterms:identifier "res_23755_rotulagem_conteudo_sintetico"^^xsd:string ;
    dcterms:source <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026> ;
    syn:confianca "5"^^xsd:integer ;
    syn:conteudo "Art. 9-B. A utilizacao na propaganda eleitoral, em qualquer modalidade, de conteudo sintetico multimidia gerado por meio de inteligencia artificial ou tecnologia equivalente para criar, substituir, omitir, mesclar ou alterar a velocidade ou sobrepor imagens ou sons, impoe ao responsavel pela propaganda o dever de informar, de modo explicito, destacado e acessivel, que o conteudo foi fabricado ou manipulado e qual tecnologia foi utilizada."^^xsd:string ;
    syn:dataOcorrencia "2026-03-02"^^xsd:date ;
    syn:declaredIn "itens/evidencias-publicas.syn"^^xsd:string ;
    syn:formaRegistro <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/forma_registro/transcricao_literal> ;
    syn:funcaoItem <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#value/funcao_item/evidencia_conceitual> ;
    syn:graph_rag_citation_guidance "Cite este ITEM com seu SOURCE de origem e descreva como ambos apoiam a decisão."@pt-BR ;
    syn:graph_rag_citation_source_id "resolucao_tse_23755_2026"^^xsd:string ;
    syn:graph_rag_evidence_review_status "pendente"^^xsd:string ;
    syn:graph_rag_evidence_reviewed "false"^^xsd:boolean ;
    syn:graph_rag_evidence_role "evidencia_conceitual"^^xsd:string ;
    syn:graph_rag_human_review_required "true"^^xsd:boolean ;
    syn:hasConcept <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#concept/conteudo_sintetico> ;
    syn:hasSource <https://github.com/diegoamrg4123/dominio-eleitoral-synesis/ontology#source/resolucao_tse_23755_2026> ;
    syn:identificadorOcorrencia "res_23755_rotulagem_conteudo_sintetico"^^xsd:string ;
    syn:justificativa "O artigo define operacionalmente o que e conteudo sintetico em contexto eleitoral e estabelece o dever de rotulagem. Ele ancora a categoria de conteudo sintetico e seus filhos (imagem, video e audio sinteticos) com vinculo normativo direto, sem converter a classificacao em conclusao de ilicitude."^^xsd:string ;
    syn:localizacaoNaFonte "Art. 9-B"^^xsd:string ;
