{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decisão provisória de classificação eleitoral",
  "type": "object",
  "required": ["scope_decision", "decision_status", "concept_ids", "supercategory_ids", "claims", "missing_evidence", "context_limitations", "human_review_required"],
  "properties": {
    "scope_decision": {"enum": ["in_scope", "out_of_scope", "uncertain"]},
    "decision_status": {"enum": ["classified_provisional", "no_matching_category", "insufficient_context", "abstained"]},
    "concept_ids": {"type": "array", "items": {"type": "string"}},
    "primary_concept_id": {"type": "string"},
    "supercategory_ids": {"type": "array", "items": {"enum": ["discurso_de_odio_eleitoral", "discursos_antidemocraticos"]}},
    "claims": {"type": "array", "items": {"type": "object", "required": ["concept_id", "quote", "criterion_used", "evidence_item_ids", "justification"], "properties": {"concept_id": {"type": "string"}, "quote": {"type": "string"}, "criterion_used": {"type": "string"}, "evidence_item_ids": {"type": "array", "items": {"type": "string"}}, "justification": {"type": "string"}}}},
    "excluded_candidates": {"type": "array"},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "context_limitations": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "concept_ids": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "then": {
        "required": ["primary_concept_id"]
      }
    }
  ],
  "additionalProperties": true
}
